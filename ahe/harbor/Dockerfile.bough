# A bough layer to bake on top of any Terminal-Bench task image.
#
# WHY THIS EXISTS. The adapter's install() uploads src/ and runs `bun install` in
# every container, which costs ~2 minutes per trial. That is tolerable for one
# proof and prohibitive for a hundred tasks: it would be five hours of the run
# doing nothing but reinstalling the same unchanged tree. Baked once per task
# image, install() finds bough already present and skips straight to the turn.
#
# BUILD ARG, NOT A FIXED BASE. Terminal-Bench tasks each declare their own image —
# ubuntu, alpine, language-specific ones — and the point is to add bough WITHOUT
# disturbing what the task set up. So the task's own image is the base and this
# only appends.
#
#   docker build -f Dockerfile.bough --build-arg BASE=<task-image> \
#     -t bough/<task-image> <bough-repo>
ARG BASE=ubuntu:24.04
FROM ${BASE}

# The interpreter, by whichever package manager this base happens to have. Failing
# soft on the package step is deliberate: some task images already carry curl and
# have no working package index, and an install that dies there would take out a
# task bough could otherwise have run.
RUN (command -v apk >/dev/null 2>&1 && apk add --no-cache curl bash unzip git) \
 || (command -v apt-get >/dev/null 2>&1 && apt-get update && apt-get install -y curl unzip git) \
 || (command -v yum >/dev/null 2>&1 && yum install -y curl unzip git) \
 || true
RUN command -v bun >/dev/null 2>&1 || (curl -fsSL https://bun.sh/install | bash \
 && install -m 0755 /root/.bun/bin/bun /usr/local/bin/bun)

# Dependencies before source, so editing bough does not re-resolve node_modules.
WORKDIR /opt/bough
COPY package.json bun.lock bunfig.toml tsconfig.json ./
RUN bun install --frozen-lockfile
COPY src ./src

RUN mkdir -p /opt/bough-home /opt/bough-trace && chmod 777 /opt/bough-home /opt/bough-trace
ENV BOUGH_HOME=/opt/bough-home BOUGH_TRACE_DIR=/opt/bough-trace BOUGH_PORT=4321
