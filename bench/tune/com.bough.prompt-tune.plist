<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd schedule for the continuous prompt tuner.

  Install:   cp bench/tune/com.bough.prompt-tune.plist ~/Library/LaunchAgents/
             launchctl load ~/Library/LaunchAgents/com.bough.prompt-tune.plist
  Run now:   launchctl start com.bough.prompt-tune
  Uninstall: launchctl unload ~/Library/LaunchAgents/com.bough.prompt-tune.plist

  Runs nightly at 02:30 via a LOGIN shell (zsh -lc) so deno/claude/gh/jq resolve
  from the user's profile — launchd's own env is bare. Requires the Mac to be
  awake at that hour (it is a daily driver). Logs to bench/results/nightly.log.
  Tune cadence/budget by editing HOURS/TRIALS in the ProgramArguments command.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bough.prompt-tune</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/andrey/repos/bough &amp;&amp; HOURS=6 TRIALS=3 bench/tune/nightly.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/andrey/repos/bough/bench/results/nightly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/andrey/repos/bough/bench/results/nightly.log</string>

  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
