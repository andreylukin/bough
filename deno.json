{
  "name": "bough",
  "version": "0.0.0",
  "exports": "./src/server/main.ts",
  "tasks": {
    "dev": "deno run --watch --allow-all src/server/main.ts",
    "test": "deno test --allow-all",
    "check": "deno check src/**/*.ts src/**/*.tsx",
    "tui": "deno run --no-prompt --allow-net=127.0.0.1 --allow-env --allow-read --allow-write=/dev/tty,$HOME/.bough --allow-sys --allow-run src/tui/main.tsx",
    "tunnel": "deno run --allow-net --allow-env --allow-run=cloudflared scripts/tunnel.ts"
  },
  "imports": {
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@1.29.0",
    "zod": "npm:zod@3.25.76",
    "zod/v4": "npm:zod@3.25.76/v4",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@0.68.0",
    "@std/yaml": "jsr:@std/yaml@1",
    "react": "npm:react@19.2.7",
    "react-dom": "npm:react-dom@19.2.7",
    "@json-render/core": "npm:@json-render/core@0.19.0",
    "@json-render/react": "npm:@json-render/react@0.19.0",
    "zod4": "npm:zod@4.3.6",
    "ink": "npm:ink@7.1.0",
    "wrap-ansi": "npm:wrap-ansi@9.0.2",
    "slice-ansi": "npm:slice-ansi@9.0.0",
    "strip-ansi": "npm:strip-ansi@7.2.0",
    "string-width": "npm:string-width@7.2.0",
    "@types/react": "npm:@types/react@19"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "nodeModulesDir": "auto",
  "unstable": [
    "worker-options"
  ],
  "fmt": {
    "lineWidth": 100,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "jsx-curly-braces"
      ]
    }
  }
}
