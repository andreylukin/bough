# Background agents as their parent's Work dialog sees them: one session
# starts children with tools.spawn({background}), serve queues them past
# its running cap, runs them, stops them on request and reports every
# finished child turn back to the parent as a notice.
#
# Code: go/internal/serve/children.go (CreateChild, launch, drainQueue,
# childEventLocked, report, stopChild), children_api.go, notify.go.
#
# Sizes are the smallest that reach every branch, and every path is one
# browser test, so the two children are not symmetric. A running cap of 1
# makes the second child queue behind the first; a per-session budget of
# 2 refuses a third spawn (429). The first child carries the whole
# lifecycle (stop, a failed first turn, a second prompt, a process exit);
# the second is only ever spawned during the first's first turn, so it
# always queues, and is then run once, or dropped. Its report is the same
# code path as the first's and is not modelled. The first child is never
# queued, so it never leaves. Each action names the child it moves: a
# oneof choice would add a node per choice to the graph, and a browser
# test per path.
#
# Every state here is one a client can wait for and then read off the
# API (the children rows, the parent's agent counts, its notices). What
# serve does on its own right after a step, with nothing a client can
# hold it on, is folded into that step:
#   - Spawn returns after launch has written the prompt, so there is no
#     booting state to act on; a Stop that races the boot is a window of
#     one exec and is not modelled.
#   - A Stop interrupts the turn and the cancel lands by itself (SIGINT
#     ends the model call): stopped, not a "stopping" a client could act
#     in.
#   - A freed slot drains the queue at once (drainQueue runs from the
#     event that freed it): the queued child is running in the same step.
#   - The report runs from the closing event and lands in about a poll:
#     a closed turn has its notice in the same step. A second one (after
#     an exit) is what would break the counts.
#   - Calls adopted as jobs need a model that calls tools; the controlled
#     model only answers text, so jobs are not modelled.
#
# Refusals change nothing serve keeps (Spawn past the budget, AgentSpawns)
# and are self-loops here: the adapter checks the HTTP status (429, 409).
#
# first and second are serve's view of each child:
#   none          no row (never spawned, or a queued child that was stopped)
#   queued        meta.Task persisted, no process, no history
#   running       a turn is open
#   done | error | stopped   the last turn closed that way
# *_slot is the child's entry in serve's running map: "serve" when serve
# started it (spawn or queue drain, both gated on the cap), "msg" when a
# message to an idle child opened a new turn (Send never checks the cap).
# first_turns counts the first child's closed turns; first_notices the
# notices the parent got for them. A second prompt is sent at most once,
# which keeps the counts at 0..2.
#
# Where this disagrees with the code as of fizz/20260923f/f-example, the
# spec says what the flow promises and the code is the finding:
#   - Message takes a slot. The code relied on an "input" event for that
#     (children.go childEventLocked) and the real headless child never
#     prints one (supervisor.go emit), so a re-messaged child held no
#     slot, was not counted running, and Stop answered "idle" without
#     interrupting it (stopChild): the Work dialog ended on "No reply".
#   - The running cap is on serve's own starts (spawn, queue drain). A
#     message to an idle child is let through past it, so the running
#     map can hold more than the cap; ServeStartsWithinCap counts only
#     the "serve" slots.

MAX_RUNNING = 1
MAX_PER_SESSION = 2
MAX_TURNS = 2

CLOSED = ("done", "error", "stopped")

role Parent:
    action Init:
        self.first = "none"
        self.first_slot = ""
        self.first_turns = 0
        self.first_notices = 0
        self.second = "none"
        self.second_slot = ""
        # meta rows spawnedBy this parent: agentCounts' total, and what
        # the per-session budget is counted against.
        self.total = 0
        # sessions a background agent managed to start (depth 2)
        self.grand = 0

    # agent: tools.spawn({background}) -> POST /api/sessions {spawnedBy}.
    # CreateChild: past the budget 429 and nothing changes; else queue
    # when the running map is full, else reserve a slot and launch.
    atomic action Spawn:
        if self.total >= MAX_PER_SESSION:
            return
        require self.first == "none" or (self.first == "running" and self.first_turns == 0)
        self.total += 1
        if self.first == "none":
            self.first = "running"
            self.first_slot = "serve"
        else:
            self.second = "queued"

    # The running first child calls tools.spawn itself: its meta has
    # SpawnedBy and it is not a person's thread, so ErrDepth (409).
    atomic action AgentSpawns:
        require self.first == "running"
        pass

    # The first child's turn closes with "done". Each close frees its
    # slot, the queue drains into it, and the parent is told once
    # (inlined: as a role func, fizz applied only its first assignment).
    atomic fair action Finish:
        require self.first == "running"
        self.first = "done"
        self.first_slot = ""
        self.first_turns += 1
        self.first_notices += 1
        if self.second == "queued":
            self.second = "running"
            self.second_slot = "serve"

    # The turn closes with an error entry in it: "failed" to the parent.
    atomic action Fail:
        require self.first == "running" and self.first_turns == 0
        self.first = "error"
        self.first_slot = ""
        self.first_turns += 1
        self.first_notices += 1
        if self.second == "queued":
            self.second = "running"
            self.second_slot = "serve"

    # user: Stop agent in the Work dialog -> POST /stop (stopChild): a
    # running child is interrupted and its turn closes "cancelled".
    atomic action Stop:
        require self.first == "running"
        self.first = "stopped"
        self.first_slot = ""
        self.first_turns += 1
        self.first_notices += 1
        if self.second == "queued":
            self.second = "running"
            self.second_slot = "serve"

    # The second child's one turn closes (its notice is not modelled).
    atomic fair action FinishSecond:
        require self.second == "running"
        self.second = "done"
        self.second_slot = ""

    # Stop on a queued child: dropped from the queue and meta, so no row,
    # and its place in the budget is given back.
    atomic action StopQueued:
        require self.second == "queued"
        self.second = "none"
        self.total -= 1

    # The parent (or a person) sends the finished first child another
    # prompt. It opens a turn, so it takes a slot; Send does not wait for
    # one.
    atomic action Message:
        require self.first in CLOSED and self.first_turns < MAX_TURNS
        self.first = "running"
        self.first_slot = "msg"

    # The first child's process exits after its reported turn (killed,
    # crashed, or serve restarted under it): the exit re-triggers report,
    # which finds the closing seq in meta.Reported and sends nothing.
    atomic action Exit:
        require self.first in CLOSED and self.first_turns > 0
        pass

action Init:
    parent = Parent()

# serve never starts a child past its running cap.
always assertion ServeStartsWithinCap:
    return len([s for s in (parent.first_slot, parent.second_slot) if s == "serve"]) <= MAX_RUNNING

# A child holds a running slot exactly while its turn is open, so the
# parent row's running count is right and Stop reaches it.
always assertion OpenTurnHoldsSlot:
    return ((parent.first == "running") == (parent.first_slot != "")) and ((parent.second == "running") == (parent.second_slot != ""))

# Each closed child turn is reported exactly once, even when its process
# exits or serve restarts after the report.
always assertion EveryTurnReportedOnce:
    return parent.first_notices == parent.first_turns

# total is the rows the parent has; a stopped queued child leaves no row
# and gives its budget back, and the budget is never exceeded.
always assertion BudgetCountsRows:
    rows = len([c for c in (parent.first, parent.second) if c != "none"])
    return parent.total == rows and parent.total <= MAX_PER_SESSION

# A background agent cannot start agents (depth 1).
always assertion DepthOne:
    return parent.grand == 0

# A queued child does not wait forever: a slot frees and drain starts it.
always eventually assertion QueueDrains:
    return parent.second != "queued"
