# Creating a local session from the web page: the palette (Cmd/Alt+N or
# the New button), its "New session in <folder>" rows and "a folder…"
# prompt, and the Overview's New session button. One person, one page,
# one serve, one create at a time.
#
# Client: app.tsx start() -> POST /api/sessions {cwd, prompt}; on 201
# markCreated + setPending (only for a non-empty prompt) + openSession.
# Server: api.go createSession checks cwd is a directory (400), then
# supervisor.go Create mints the id, spawns `bough --headless --json`
# with BOUGH_SESSION_ID set and waits for that one history file before
# claim, or kills the child at createTimeout (10 s), or reports the
# child's exit. (It used to diff the history directory instead; see
# OtherWrites.)
#
# Where the code disagrees with the mapped model this was written from:
# - Cmd/Alt+N opens the palette with palCwd "" (home); only the New
#   button aims it at the open row's folder. Both are OpenPalette here.
# - A typed path is not a prompt by default, but the palette still
#   offers an explicit "Start a session: “~/x”" row below its folder
#   rows, and picking it sends the path as the first message. So the
#   claim is "only an explicit Start pick sends text", not "a path is
#   never a prompt".
# - A local create never reaches StartingRetry: Create waits for the
#   minted id's history file, so it exists before the 201 and the
#   first GET /api/sessions/<id> cannot 404. The "starting" retry is
#   for project sessions (and a child that volunteers its id on a meta
#   line before writing history, which the current build never does).
#   It is kept as a ui value so NeverStarting says so.
# - "Not sent" is not an outcome of a create: a failed create has no
#   preview at all (setPending runs only after the 201), only the toast.
#
# The empty starts (New session in <folder>, a folder…, Overview New)
# POST prompt "" and so spawn a live child at once, which the comment
# above newSession() says never happens: the state opened with first
# "empty" is that child, idle, holding a lease. It is reachable because
# the product does it today (a design gap, reported, not asserted away).

role Create:
    action Init:
        # idle | palette | folder | creating | opened | starting | failed
        self.ui = "idle"
        # what is typed in the palette: none | text | path
        self.query = "none"
        # the first message of the create in flight: none | text | empty
        self.first = "none"
        # this create's child: none | spawned (no id yet) | live (claimed)
        self.child = "none"
        # the child has written its history file
        self.hist = False
        # another bough wrote a history file during discovery
        self.other = False
        # the first prompt shown as "Sending…" / recorded as its turn
        self.sending = False
        self.recorded = False

    # Cmd/Alt+N, or the New button.
    atomic action OpenPalette:
        require self.ui == "idle"
        self.ui = "palette"
        self.query = "none"

    atomic action Escape:
        require self.ui in ("palette", "folder")
        self.ui = "idle"
        self.query = "none"

    atomic action TypeText:
        require self.ui == "palette" and self.query != "text"
        self.query = "text"

    # Offers folder rows from GET /api/dirs.
    atomic action TypePath:
        require self.ui == "palette" and self.query != "path"
        self.query = "path"

    # A folder row aims the palette (palCwd) and clears the query:
    # nothing is created.
    atomic action PickFolder:
        require self.ui == "palette" and self.query == "path"
        self.query = "none"

    # The explicit Start row: "Start a session: “…”".
    atomic action StartTyped:
        require self.ui == "palette" and self.query != "none"
        self.ui = "creating"
        self.query = "none"
        self.first = "text"
        self.child = "spawned"

    # "New session in <folder>": start(dir, "").
    atomic action StartEmpty:
        require self.ui == "palette"
        self.ui = "creating"
        self.query = "none"
        self.first = "empty"
        self.child = "spawned"

    # The Overview's New session button: start(home or startDir, "").
    atomic action OverviewNew:
        require self.ui == "idle"
        self.ui = "creating"
        self.first = "empty"
        self.child = "spawned"

    # "New session in a folder…" asks for a path.
    atomic action AskFolder:
        require self.ui == "palette"
        self.ui = "folder"
        self.query = "none"

    atomic action FolderStart:
        require self.ui == "folder"
        self.ui = "creating"
        self.first = "empty"
        self.child = "spawned"

    # 400: cwd is not a directory. Nothing is spawned.
    atomic action FolderMissing:
        require self.ui == "folder"
        self.ui = "failed"

    atomic fair action WriteHistory:
        require self.child == "spawned" and not self.hist
        self.hist = True

    # An unrelated bough writes a history file while Create waits. With
    # discovery by directory diff this either timed out (two new ids) or,
    # landing before the child's file, claimed the unrelated session as
    # the new one; the minted id makes it irrelevant, which Claim and
    # Timeout now say by not reading it.
    atomic action OtherWrites:
        require self.child == "spawned" and not self.other
        self.other = True

    # The child's file: claim, write the prompt line, 201, open #/s/<id>.
    atomic fair action Claim:
        require self.child == "spawned" and self.hist
        self.child = "live"
        self.ui = "opened" if self.hist else "starting"
        self.sending = self.first == "text"

    # createTimeout with no history file: the child is killed, 500.
    atomic fair action Timeout:
        require self.child == "spawned" and not self.hist
        self.child = "none"
        self.ui = "failed"

    # "session exited before writing history", 500.
    atomic fair action ChildExits:
        require self.child == "spawned" and not self.hist
        self.child = "none"
        self.ui = "failed"

    # The input entry lands: the preview gives way to the recorded turn.
    atomic fair action Land:
        require self.sending
        self.sending = False
        self.recorded = True

    # Back to the overview; the session lives on under its row.
    atomic action Close:
        require self.ui == "opened" and not self.sending
        self.ui = "idle"
        self.first = "none"
        self.child = "none"
        self.hist = False
        self.other = False
        self.recorded = False

    # The "Couldn't start a session" toast is dismissed.
    atomic action Dismiss:
        require self.ui == "failed"
        self.ui = "idle"
        self.first = "none"
        self.hist = False
        self.other = False

action Init:
    create = Create()

# A created id has a history file before the 201 is returned.
always assertion CreatedHasHistory:
    return create.child != "live" or create.hist

# A local create never shows "starting": its first read cannot 404.
always assertion NeverStarting:
    return create.ui != "starting"

# Typing, browsing folders or answering the folder prompt spawns nothing
# until a Start pick; and nothing is spawned outside a create.
always assertion NoChildWithoutPick:
    return create.child == "none" or create.ui in ("creating", "opened", "starting")

# A failed create leaves no child: a timeout kills it.
always assertion FailedLeavesNoChild:
    return create.ui != "failed" or create.child == "none"

# The first prompt is on screen once: as the preview or as the turn.
always assertion PromptShownOnce:
    return not (create.sending and create.recorded)

# Only a create with text shows a preview, and only once it is live.
always assertion PreviewOnlyForText:
    return not create.sending or (create.first == "text" and create.child == "live")

# A create settles: opened or failed, never creating forever.
always eventually assertion CreateSettles:
    return create.ui != "creating"

# A Sending preview gives way to the recorded turn.
always eventually assertion PreviewLands:
    return not create.sending
