---
# Both children finished and the project deleted (or the editor shut)
# is where this flow ends: rest, not a deadlock.
deadlock_detection: false
---

# tools.secret after the person answers: what the transcript says, what
# the keychain holds and what project.yml references, when the answer is
# a decline, the keychain refuses the value, the project is deleted while
# the question is open, or other writers change project.yml in between.
# Recipe: go/tests/model/README.md. ask_answer.fizz covers the question
# itself (the secret is never logged); this spec starts where it stops.
#
# Two children, A and B, each ask for one secret in the same project
# (plugins/ask/ask.go secretVia): Load the project, ask, trim, decline on
# "" or "(declined)", secrets.Store into the keychain, then
# projectdef.SetSecret adds `secrets: {NAME: keychain:bough/<slug>/NAME}`
# to project.yml. The person can meanwhile rename the project (serve
# RenameProject -> projectdef.SetName, a textual splice), edit project.yml
# in the web editor (PUT orb/files/project.yml -> projectdef.WriteFile) or
# delete it (serve DeleteProject removes the directory; the keychain is
# not touched).
#
# This is the contract, not today's code. Where the code differs (see the
# "Today" notes on each action) the MBT and browser walks of this spec are
# expected to go red:
#   - Asker.Answer writes "ask/answer" {text: "[secret stored]"} the
#     moment the answer arrives, and the page renders it "secret stored",
#     for a decline and before the keychain or project.yml was touched.
#   - SetSecret yaml.Marshal's the whole Def back over the file, dropping
#     every comment and reordering keys (SetName is textual for exactly
#     this reason).
#   - SetSecret, SetName and WriteFile are each an unlocked
#     read-modify-write of project.yml and the editor save carries no base
#     version, so two writers can lose one's edit. The spec makes each
#     write one atomic step (a per-project lock) and refuses an editor
#     save whose base is no longer the file.
#   - A SetSecret that fails (project deleted while the question was
#     open) leaves the value it just stored in the keychain with nothing
#     referencing it; the contract removes it again.
#
# Per child x in {a, b}:
#   xPhase  "idle" | "asked" (question open) | "answered" (value in hand)
#           | "kc" (keychain holds it, SetSecret not yet run) | "over"
#   xHist   what the transcript says about the secret: "" nothing yet,
#           "received" (an answer arrived; the ask/answer line, which must
#           not claim more), "declined", "failed" (the tool call returned
#           an error), "stored" (the tool call returned "stored ...").
#   xKc     the keychain holds bough/<slug>/X.
#   xRef    project.yml's secrets.X: "" none, "set", "gone" (it was set
#           and the project has since been deleted by the person).
# Project:
#   disk      "ok" | "none" (the directory is gone)
#   name      the name: line, "Alpha", renamed once to "Beta"
#   renamed   the person's rename was answered ok (sticky)
#   comments  project.yml still carries the comments it ships and the
#             person wrote
#   editor    "closed" | "open": the web editor holding project.yml's text
#   edName, edA, edB   the text the editor loaded: its name: line and
#             whether it has A's and B's refs ("" while closed)
#
# Not modelled: the secret value itself (ask_answer.fizz), a second
# question per child (each asks once, so the graph stays finite),
# recreating a deleted project, and the person removing a secret by hand
# in the editor.

role Project:
    action Init:
        self.disk = "ok"
        self.name = "Alpha"
        self.renamed = False
        self.comments = True
        self.editor = "closed"
        self.edName = ""
        self.edA = ""
        self.edB = ""
        self.aPhase = "idle"
        self.aHist = ""
        self.aKc = False
        self.aRef = ""
        self.bPhase = "idle"
        self.bHist = ""
        self.bKc = False
        self.bRef = ""

    # --- child A -------------------------------------------------------

    # tools.secret("A_TOKEN", ..., slug): Load succeeds only while the
    # project exists; then the question is put and the call blocks.
    atomic action AskSecretA:
        require self.disk == "ok" and self.aPhase == "idle"
        self.aPhase = "asked"

    # The person types the value and sends it. Today: Asker.Answer
    # records "[secret stored]" here, which the page shows as "secret
    # stored" although nothing is stored yet.
    atomic action AnswerSecretA:
        require self.aPhase == "asked"
        self.aPhase = "answered"
        self.aHist = "received"

    # Esc / an empty answer: "(declined)". The call returns "secret: user
    # declined". Today: history says "[secret stored]".
    atomic action DeclineA:
        require self.aPhase == "asked"
        self.aPhase = "over"
        self.aHist = "declined"

    atomic fair action KeychainStoreOkA:
        require self.aPhase == "answered"
        self.aPhase = "kc"
        self.aKc = True

    # secrets.Store fails (locked keychain, security(1) error): nothing
    # was written, the call returns "secret: store failed".
    atomic fair action KeychainStoreFailA:
        require self.aPhase == "answered"
        self.aPhase = "over"
        self.aHist = "failed"

    # projectdef.SetSecret, one atomic step under the project's lock. The
    # ref is spliced into the text, so comments and the name stay.
    atomic fair action SetSecretA:
        require self.aPhase == "kc"
        self.aPhase = "over"
        if self.disk == "ok":
            self.aRef = "set"
            self.aHist = "stored"
        else:
            # Load fails: the project is gone. The value stored a step ago
            # is removed again. Today: it stays in the keychain, orphaned.
            self.aKc = False
            self.aHist = "failed"

    # --- child B: the same, for B_TOKEN ---------------------------------

    atomic action AskSecretB:
        require self.disk == "ok" and self.bPhase == "idle"
        self.bPhase = "asked"

    atomic action AnswerSecretB:
        require self.bPhase == "asked"
        self.bPhase = "answered"
        self.bHist = "received"

    atomic action DeclineB:
        require self.bPhase == "asked"
        self.bPhase = "over"
        self.bHist = "declined"

    atomic fair action KeychainStoreOkB:
        require self.bPhase == "answered"
        self.bPhase = "kc"
        self.bKc = True

    atomic fair action KeychainStoreFailB:
        require self.bPhase == "answered"
        self.bPhase = "over"
        self.bHist = "failed"

    atomic fair action SetSecretB:
        require self.bPhase == "kc"
        self.bPhase = "over"
        if self.disk == "ok":
            self.bRef = "set"
            self.bHist = "stored"
        else:
            self.bKc = False
            self.bHist = "failed"

    # --- the person ------------------------------------------------------

    # Rename in the web: SetName splices the name: line, atomically with
    # respect to the other writers (today: unlocked).
    atomic action RenameProject:
        require self.disk == "ok" and self.name == "Alpha"
        self.name = "Beta"
        self.renamed = True

    # Delete in the web (the confirm typed back): the directory goes, and
    # with it every ref; the keychain entries of finished secrets stay
    # (DeleteProject does not touch the keychain). An open editor goes
    # with the page it was on.
    atomic action DeleteProject:
        require self.disk == "ok"
        self.disk = "none"
        if self.aRef == "set":
            self.aRef = "gone"
        if self.bRef == "set":
            self.bRef = "gone"
        self.closeEditor()

    # The orb page's project.yml editor loads the file as it is now.
    atomic action EditOpen:
        require self.disk == "ok" and self.editor == "closed"
        self.editor = "open"
        self.edName = self.name
        self.edA = self.aRef
        self.edB = self.bRef

    # Save with the file unchanged since the editor loaded it: the
    # person's text (their added comment) is the file; nothing else moves.
    atomic action EditSave:
        require self.editor == "open" and self.edName == self.name and self.edA == self.aRef and self.edB == self.bRef
        self.closeEditor()

    # Save after another writer changed the file under the editor: refused
    # (409) and the editor reloads the current file for the person to
    # redo their edit. Today: WriteFile takes the text blind and reverts
    # the rename or drops the ref written since the editor loaded.
    atomic action EditSaveStale:
        require self.editor == "open" and (self.edName != self.name or self.edA != self.aRef or self.edB != self.bRef)
        self.edName = self.name
        self.edA = self.aRef
        self.edB = self.bRef

    atomic action EditCancel:
        require self.editor == "open"
        self.closeEditor()

    atomic func closeEditor():
        self.editor = "closed"
        self.edName = ""
        self.edA = ""
        self.edB = ""

action Init:
    project = Project()

# The transcript says "stored" only once the keychain holds the value and
# project.yml references it (or did, until the person deleted the
# project). A decline, a keychain failure or an answer still in flight
# never reads as stored.
always assertion StoredMeansHeld:
    return ((project.aHist != "stored" or (project.aKc and project.aRef != "")) and
            (project.bHist != "stored" or (project.bKc and project.bRef != "")))

# No writer of project.yml undoes another's: a ref a child reported
# stored stays until the project is deleted, and a rename the person was
# told succeeded stays.
always assertion NoLostUpdate:
    return ((project.aHist != "stored" or project.aRef in ("set", "gone")) and
            (project.bHist != "stored" or project.bRef in ("set", "gone")) and
            (not project.renamed or project.disk == "none" or project.name == "Beta"))

# SetSecret keeps project.yml's comments.
always assertion CommentsKept:
    return project.comments

# A keychain entry with nothing referencing it exists only between the
# keychain write and SetSecret: a failed store leaves none behind.
always assertion NoOrphanKeychain:
    return ((not project.aKc or project.aRef != "" or project.aPhase == "kc") and
            (not project.bKc or project.bRef != "" or project.bPhase == "kc"))

# An answered secret is settled: the keychain and project.yml are written
# (or it failed and says so) without the person doing anything more.
always eventually assertion AnswersSettle:
    return project.aPhase not in ("answered", "kc") and project.bPhase not in ("answered", "kc")

# Once both children's values are in the keychain, both refs end up in
# project.yml (or the project is gone).
always eventually assertion BothRefsLand:
    return not (project.aKc and project.bKc) or project.disk == "none" or (project.aRef == "set" and project.bRef == "set")
