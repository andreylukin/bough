# The host side of repos changing under a project's sessions, split out
# of repos_change_under_live_sessions.fizz for the state budget: a local
# checkout moved away from its path:, the remote unreachable, and the
# project's main thread starting while either holds. A is a local repo
# (path:), B a remote one cloned into ~/.bough/orbs/cache/<slug>/; B can
# be added and removed. A start is Prepare then Start in one step here:
# the container side is the sibling spec's.
#
# Where the code disagreed with the mapped model (and the code won):
#   - SyncRepos does NOT fail on a network blip with a complete cache:
#     syncCache ignores a failed fetch of an existing clone (worktree.go
#     syncCache). Only a repo not cloned yet fails the sync (git clone),
#     and then it fails every start in the project: the session's
#     resume and the main thread alike, since every start syncs every
#     repo before its worktrees.
#   - A moved checkout fails a resume as well as a new session:
#     addWorktree skips an existing worktree, but commonGitDir follows
#     its .git file to the old path; a new one's `git worktree add` runs
#     in a dir that is gone.
#   - The main thread is a session of its own with the same Prepare, and
#     one cache: a clone by either start serves the other.
#
# Fields (role Host):
#   repos    project.yml repos: "A" | "AB"
#   moved    A's checkout is no longer at its path:
#   net      B's remote is reachable
#   cache    B's cache clone exists
#   file     the session's state.json: none | running | failed | stopped
#   why      the phase its failed start failed in: "" | sync | worktree
#   main     the project's main thread: none | up | failed

role Host:
    action Init:
        self.repos = "A"
        self.moved = False
        self.net = True
        self.cache = False
        self.file = "none"
        self.why = ""
        self.main = "none"

    atomic action AddRepo:
        require self.repos == "A"
        self.repos = "AB"

    atomic action RemoveRepoB:
        require self.repos == "AB"
        self.repos = "A"

    atomic action HostMovesCheckout:
        require not self.moved
        self.moved = True

    atomic action HostRestoresCheckout:
        require self.moved
        self.moved = False

    atomic action NetworkDown:
        require self.net
        self.net = False

    atomic fair action NetworkUp:
        require not self.net
        self.net = True

    # A start, resume or respawn of the session (after a failed one, the
    # person's retry).
    atomic action Start:
        require self.file != "running"
        self.why = cause(self)
        self.file = "failed" if self.why else "running"
        self.cloned()

    atomic action Exit:
        require self.file == "running"
        self.file = "stopped"

    # A message to the project starts (or retries) its main thread.
    atomic action MessageProject:
        require self.main != "up"
        self.main = "failed" if cause(self) else "up"
        self.cloned()

    atomic action MainExits:
        require self.main == "up"
        self.main = "none"

    # SyncRepos clones B when it is a repo and the remote answers.
    atomic func cloned():
        if "B" in self.repos and self.net:
            self.cache = True

# orb.Prepare's outcome: SyncRepos (clone what is missing, fetch the rest
# and ignore a failed fetch), then each repo's worktree.
def cause(h):
    if "B" in h.repos and not h.cache and not h.net:
        return "sync"
    if h.moved:
        return "worktree"
    return ""

action Init:
    host = Host()

# A start fails at sync only when the clone it needed was missing: a
# failed fetch with a complete cache does not stop a session.
transition assertion FetchBlipWithCacheStarts(before, after):
    if before.host.file != "running" and after.host.why == "sync" and after.host.file == "failed" and before.host.why != "sync":
        return not before.host.cache and not before.host.net
    return True

# Every failed start names a cause the host still had at that moment:
# the remote down with no clone, or the checkout moved.
transition assertion StartFailsOnlyForACause(before, after):
    if after.host.file == "failed" and (before.host.file != "failed" or before.host.why != after.host.why):
        if after.host.why == "sync":
            return "B" in before.host.repos and not before.host.cache and not before.host.net
        return after.host.why == "worktree" and before.host.moved
    return True

# The main thread fails to start for the same causes and no other.
transition assertion MainFailsOnlyForACause(before, after):
    if before.host.main != "failed" and after.host.main == "failed":
        return before.host.moved or ("B" in before.host.repos and not before.host.cache and not before.host.net)
    return True

# A clone, once made, is never lost to a failed start.
transition assertion CacheKept(before, after):
    return not before.host.cache or after.host.cache

# An outage ends (NetworkUp is fair): the remote comes back.
always eventually assertion NetworkReturns:
    return host.net
