# The repos in a project's project.yml change (add, remove, reorder)
# while a session of the project and its container exist. One session
# (its orb dir, worktrees, container) of a project with two repos, A and
# B; A starts as the only one. The definition is read once per start
# (plugins/orb Apply loads project.yml; nothing reloads it under a live
# session), so an edit reaches the session only at its next start.
# The host side (a moved checkout, the remote down, the main thread) is
# the sibling spec repos_change_host_failures.fizz: together they were
# over the state budget.
#
# Where the code disagreed with the mapped model (and the code won):
#   - The container's own workdir (-w at create) is only a default:
#     every exec passes Workdir state.Primary (orb.go Exec/Command). A
#     reorder whose new primary is mounted is harmless; what matters is
#     that the primary is mounted in the guest (PrimaryInGuest), not that
#     it equals -w.
#   - remove-repo does not endanger the branch: Remove never deletes a
#     branch, and prune deletes only merged ones. What it endangers is a
#     DIRTY worktree: the next start drops the repo from
#     state.Worktrees, PlanRemove checks dirtiness only there, and Remove
#     then `git worktree remove --force`s every worktree in the orb dir
#     (removed == "lost"). The unmerged branch survives, but the plan
#     no longer names it (branches are outside this state: budget).
#   - Declaring B's lockfile in setup.sh (`# bough:uses`) while B is not
#     a repo fails the hash ("no repo tracks it", StepLockfiles), so the
#     image gains B's lockfile only once B is a repo; it then changes the
#     tag, and Start removes and recreates the container with every
#     mount. Without such a declaration the tag does not change.
#
# Design gaps the model reaches (findings, not fixed here):
#   G1 A resume after add-repo reuses the container when the tag did not
#      change (no declared lockfile in B): B's worktree is on the host and
#      in state.Worktrees but not mounted, and nothing tells the session
#      (Worktree_B_on_host_not_mounted). The mapped liveness "a resumed
#      session sees the new repo or is told to restart its container" is
#      false in the product; see MountedAfterStart's carve-out.
#   G2 A reorder, or a remove of repos[0], under a reused container moves
#      state.Primary to a worktree the guest may not mount: every exec's
#      -w names a missing dir (Exec_cwd_not_in_container).
#   G3 remove-repo of a repo whose worktree is dirty, a restart, then
#      Remove: the dirty work is destroyed and the plan never named it.
#
# Fields (role Orb):
#   repos    project.yml repos in order: "A" | "AB" | "BA"
#   uses     setup.sh declares a lockfile only B tracks
#   live     the session's process owns the orb
#   file     state.json: none | prepared | running | failed | stopped
#   orphan   B's worktree is in the orb dir on the host but not in
#            state.Worktrees (remove-repo, then a start); A's is not
#            tracked, it carries no work in this model
#   st       state.Worktrees (a set)
#   primary  the live session's state.Primary (its cwd and every exec's
#            -w): "" while no process owns the orb | A | B
#   ctr      the container: missing | stopped | running
#   mnt      the worktrees the container mounts (a set, fixed at create)
#   img      the container's tag: "" (no B lockfile) | "B"
#   reused   the live session's start reused the existing container
#   dirty    B's worktree has uncommitted changes (a commit lands on
#            bough/<session>, which every Remove keeps)
#   removed  what the last Remove did to B's work, reset by the next
#            start: "" (nothing lost; a listed dirty worktree refuses the
#            Remove) | lost (dirty work destroyed unreported, G3)
#            | lost_listed (a listed dirty worktree destroyed: never)

role Orb:
    action Init:
        self.repos = "A"
        self.uses = False
        self.live = False
        self.file = "none"
        self.orphan = False
        self.st = ""
        self.primary = ""
        self.ctr = "missing"
        self.mnt = ""
        self.img = ""
        self.reused = False
        self.dirty = False
        self.removed = ""

    # --- project.yml and setup.sh (bough project add-repo / remove-repo,
    # or an agent's edit; reorder is an edit) ---

    atomic action AddRepo:
        require "B" not in self.repos
        self.repos = self.repos + "B"

    # remove-repo of B. Removing A (or every repo) is left out for the
    # state budget: B alone as repos[0] is what Reorder already reaches.
    atomic action RemoveRepoB:
        require len(self.repos) == 2
        self.repos = "A"

    atomic action Reorder:
        require len(self.repos) == 2
        self.repos = self.repos[1] + self.repos[0]

    atomic action DeclareUses:
        require not self.uses and "B" in self.repos
        self.uses = True

    atomic action DropUses:
        require self.uses
        self.uses = False

    # --- the session's process ---

    # A start or resume (a respawn is Exit then this): Prepare reads
    # project.yml, adds or reuses each repo's worktree in order
    # (prepareMounts; state.Worktrees restarts empty; a removed repo's
    # worktree stays in the dir) and moves into the primary.
    atomic action Prepare:
        require not self.live
        self.live = True
        self.removed = ""
        self.orphan = self.orphan or ("B" in self.st and "B" not in self.repos)
        if "B" in self.repos:
            self.orphan = False
        self.st = ""
        for i in range(len(self.repos)):
            self.st = add(self.st, self.repos[i])
        self.primary = self.repos[0]
        self.file = "prepared"

    # Start: the tag (hashing B's lockfile when setup.sh uses it; fails
    # when no repo tracks it), then the container, reused as it was
    # (mounts, workdir) when it exists and runs the same tag, else
    # removed and created from this start.
    atomic fair action Start:
        require self.live and self.file == "prepared"
        if self.uses and "B" not in self.repos:
            self.file = "failed"
            return
        tag = "B" if self.uses else ""
        if self.ctr != "missing" and self.img == tag:
            self.reused = True
        else:
            self.mnt = self.st
            self.img = tag
            self.reused = False
        self.ctr = "running"
        self.file = "running"

    # An exec finds the container stopped (Stop orb, the reaper) and
    # starts it as it was (ensureRunningLocked), then runs in -w primary.
    # (A missing container needs a Remove, which needs the session gone.)
    atomic action ExecInGuest:
        require self.live and self.file == "stopped" and self.ctr == "stopped"
        self.ctr = "running"
        self.file = "running"

    atomic action EditB:
        require self.live and self.file == "running" and "B" in self.st and not self.dirty
        self.dirty = True

    atomic action CommitB:
        require self.live and self.file == "running" and "B" in self.st and self.dirty
        self.dirty = False

    # Stop orb from the page, or the reaper: the process stays.
    atomic action StopOrb:
        require self.live and self.ctr == "running"
        self.ctr = "stopped"
        self.file = "stopped"

    # The session exits (or is killed): Orb.Stop keeps the worktrees and
    # the container, stopped.
    atomic action Exit:
        require self.live and self.file != "prepared"
        self.live = False
        self.primary = ""
        self.reused = False
        if self.ctr == "running":
            self.ctr = "stopped"
        if self.file == "running":
            self.file = "stopped"

    # --- serve: DELETE orb / prune ---

    # PlanRemove refuses on a dirty worktree listed in state.Worktrees
    # and names the bough/<session> branches of the current repos and of
    # state.Worktrees; Remove force-removes every worktree in the orb dir
    # and keeps every branch.
    atomic action RemoveOrb:
        require not self.live and self.file != "none"
        if "B" in self.st and self.dirty:
            return
        if (self.orphan or "B" in self.st) and self.dirty:
            self.removed = "lost_listed" if "B" in self.st else "lost"
            self.dirty = False
        self.file = "none"
        self.orphan = False
        self.st = ""
        self.primary = ""
        self.ctr = "missing"
        self.mnt = ""
        self.img = ""
        self.reused = False

# A set of repo names as a canonical string.
def add(s, r):
    a = "A" in s or r == "A"
    b = "B" in s or r == "B"
    return ("A" if a else "") + ("B" if b else "")

def subset(s, t):
    return ("A" not in s or "A" in t) and ("B" not in s or "B" in t)

action Init:
    orb = Orb()

# A container this start created mounts every worktree in
# state.Worktrees. A reused one keeps the mounts it was created with (G1).
always assertion MountedAfterStart:
    return not (orb.ctr == "running" and not orb.reused) or subset(orb.st, orb.mnt)

# The primary every exec runs in (-w) exists in the guest, except in a
# reused container (G2).
always assertion PrimaryInGuest:
    return not (orb.file == "running" and not orb.reused) or orb.primary in orb.mnt

# The primary is one of the session's worktrees.
always assertion PrimaryIsAWorktree:
    return orb.file not in ("prepared", "running") or orb.primary in orb.st

# Remove never destroys dirty work in a worktree state.json lists; one
# that remove-repo dropped from the list is destroyed unreported (G3).
always assertion RemoveKeepsListedDirtyWork:
    return orb.removed != "lost_listed"

# A start runs the tag the definition hashes to: a declared lockfile of
# a repo just added retags the image and recreates the container.
transition assertion ContainerRunsItsTag(before, after):
    if before.orb.file == "prepared" and after.orb.file == "running":
        return after.orb.img == ("B" if after.orb.uses else "")
    return True

# A prepared start always ends, running or failed (Start is fair: the
# child runs it right after Prepare).
always eventually assertion StartSettles:
    return orb.file != "prepared"
