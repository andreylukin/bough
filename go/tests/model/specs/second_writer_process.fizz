# Two processes on one session store. Every other spec takes `bough
# serve` as the only writer of ~/.bough/sessions and serve/meta.json;
# this one lets a second process in: a second serve (a hand-run
# `serve --run`, launchd's KeepAlive respawn, the new binary `bough
# update` installs, a `bough serve` after a `serve stop` that gave up)
# and a terminal `bough -r <id>` on a session serve supervises.
#
# Processes, bounded to two serves: A serves at Init (launchd's job);
# B is whichever serve starts next. One session S, which A has queued as
# a background agent behind its running cap (meta.Task persisted). Its
# writers are A's child (akid), B's child (bkid) and a terminal bough
# (cli).
#
# What the code does (cmd/bough/serve.go, update.go, launchd.go;
# internal/serve/supervisor.go, children.go, status.go;
# plugins/history):
#
# - serveForeground: writeServePidfile, then NewSupervisor (loadMeta,
#   requeueLocked, migrateProjects, `go drainQueue()`), then
#   net.Listen. drainQueue clears the task, saves meta.json and
#   launches the child before Listen has run. A failed Listen returns,
#   and the deferred sup.Close kills what the drain started.
# - Shutdown on SIGINT/SIGTERM: srv.Shutdown closes the listener first,
#   then the deferred sup.Close kills and reaps every child (orb stops
#   included), then the deferred pidfile cleanup runs. So between the
#   signal and the exit the port is free while the process still owns
#   children and appends to their files (A "stopping").
# - The pidfile cleanup is os.Remove(pf), whoever the file names now.
#   writeServePidfile leaves a live foreign pid's file alone but does
#   not refuse to start.
# - `serve stop` signals, waits 100 x 50 ms, and removes the pidfile
#   whether or not the process exited. restartServe (update) waits up
#   to 10 s, then removes the pidfile unconditionally ("the exiting
#   process usually removed it") and re-installs the launchd agent
#   (bootout + bootstrap). The agent is KeepAlive: when the signalled
#   serve exits while the job is still loaded, launchd respawns the OLD
#   binary before the bootout.
# - `bough serve` (start) refuses only when runningServe finds a live
#   pid in the pidfile.
# - The history file has no lease: Store.Append flocks per append, and a
#   second appender is only detected afterwards (catchUp, the
#   ConcurrentWriter notice). ensure checks s.kids, this process's own
#   children; StatusOf reads an open turn with no child of this serve
#   as interrupted, so a terminal's turn shows interrupted on the web
#   and a web prompt spawns a second `bough -r S` beside it.
#
# Where this disagrees with the code, the spec says what the flow
# promises and the code is the finding (the red-first mutations below
# put each code behaviour back and name the invariant it breaks):
#   F1 A serve binds and checks the pidfile BEFORE it loads meta.json or
#      drains: a start that finds the port held, or the pidfile naming a
#      live other serve, exits having spawned nothing and written
#      nothing (BListen). Code: drain first (FailedStartTouchedNothing,
#      OneMetaWriter).
#   F2 A pidfile is only removed by the process it names, or as stale
#      (its pid dead): exit cleanup, `serve stop` and restartServe
#      compare before removing. Code: unconditional (PidfileNamesServer).
#   F3 `serve stop` that gives up leaves the pidfile naming the live,
#      still-reaping serve; the next start waits it out (the launchd
#      agent is installed and its retries fail F1's check until the old
#      process is gone). Code: removed after 5 s, and a start then runs
#      beside it (OneSupervisor, OneWriterPerSession).
#   F4 A session has one lease across processes: a terminal bough holds
#      it for its life, serve shows the session as running elsewhere,
#      refuses a web prompt and does not drain its queued task into it;
#      a terminal resume refuses a session a serve child holds. Code: no
#      lease (CliTurnNotInterrupted, OneWriterPerSession).
#
# Mapped states, as field combinations:
#   AServing                 a=serving pf=A
#   AStopping                a=stopping (port free, children reaping)
#   StopGaveUp               a=stopping waiting=False, pf=A (F3)
#   BStarting                b=starting (nothing loaded yet, F1)
#   BListenFailed            b=failed bwrote=False bkid=False
#   BServing                 b=serving pf=B
#   AExitRemovesBsPidfile,   unreachable (F2): the mutations reach them
#   PidfileOrphan,
#   TwoWritersMeta,
#   TwoChildrenOneSession,
#   ForkedHistory
#   LaunchdRespawnDuringReinstall  upd=True a=gone b=starting|serving
#   CliRunningTurn_WebShowsInterrupted  cli=turn shown=elsewhere (F4)
#   WebPromptSpawnsSecondWriter  unreachable (F4)
#
# Not modelled: a third serve (UpdateReinstall reuses B's slot for the
# bootstrapped binary); B stopping (only A is stopped); a terminal that
# exits mid-turn (its dangling turn is the ordinary interrupted case of
# serve_restart_resume); titles/archive/ack in meta.json, which stand
# with the task behind OneMetaWriter.

role Host:
    action Init:
        self.a = "serving"      # serving | stopping | gone
        self.b = "none"         # none | starting | failed | serving
        self.pf = "A"           # whom ~/.bough/serve.pid names: A | B | none
        self.managed = True     # the launchd agent (KeepAlive) is loaded
        self.waiting = False    # a `serve stop` is waiting for A to exit
        self.upd = False        # a `bough update` restart is in progress
        self.task = "queued"    # S's persisted meta.Task: queued | started
        self.akid = False
        self.bkid = False
        self.cli = "none"       # terminal bough on S: none | idle | turn
        self.turn = "closed"    # S's history: open | closed
        # B spawned a child or wrote meta.json during this start.
        self.bwrote = False
        self.shown = status_of(self)

    # ---- serve A ----

    # A's running slot frees and its drain starts S (children.go
    # drainQueue). F4: not into a session a terminal holds.
    atomic fair action DrainA:
        require self.a == "serving" and self.task == "queued" and self.cli == "none" and not self.bkid
        self.akid = True
        self.task = "started"
        self.turn = "open"
        self.shown = status_of(self)

    # `bough serve stop`: unload the agent, SIGINT, wait.
    atomic action ServeStop:
        require self.a == "serving" and not self.waiting and not self.upd
        self.managed = False
        self.a = "stopping"
        self.waiting = True
        self.shown = status_of(self)

    # The stop's 5 s wait ends, A gone or not. F2/F3: the pidfile goes
    # only when the pid it names is dead.
    atomic fair action StopReturn:
        require self.waiting
        self.waiting = False
        if self.pf == "A" and self.a == "gone":
            self.pf = "none"
        self.shown = status_of(self)

    # sup.Close has killed and reaped every child; the deferred pidfile
    # cleanup runs and the process exits. F2: only its own pidfile.
    atomic fair action CloseDone:
        require self.a == "stopping"
        self.a = "gone"
        self.akid = False
        if self.pf == "A":
            self.pf = "none"
        self.shown = status_of(self)

    # SIGKILL, a panic: no cleanup, the pidfile stays naming a dead pid.
    # The children go too (launchd reaps the job's group; a detached
    # serve's children read EOF on stdin).
    atomic action Crash:
        require self.a == "serving"
        self.a = "gone"
        self.akid = False
        self.shown = status_of(self)

    # `bough update`: restartServe SIGINTs A with the agent still loaded.
    atomic action UpdateSignal:
        require self.a == "serving" and not self.waiting and not self.upd
        self.upd = True
        self.a = "stopping"
        self.shown = status_of(self)

    # A is gone: restartServe removes the pidfile (F2: only a stale one),
    # then installServeAgent boots out whatever launchd respawned (its
    # Close kills its children; its cleanup removes its own pidfile) and
    # bootstraps the new binary, which starts at once (RunAtLoad).
    atomic fair action UpdateReinstall:
        require self.upd and self.a == "gone"
        self.upd = False
        if self.pf == "A":
            self.pf = "none"
        self.bkid = False
        if self.pf == "B":
            self.pf = "none"
        self.managed = True
        self.b = "starting"
        self.bwrote = False
        self.shown = status_of(self)

    # ---- serve B ----

    # `bough serve` with no serve serving: installs the launchd agent,
    # whose first run starts now. F3: a stopping A's pidfile is still
    # there, so this start's check fails and launchd retries it.
    atomic action ServeStart:
        require not self.managed and not self.waiting and self.a != "serving" and self.b in ("none", "failed")
        self.managed = True
        self.b = "starting"
        self.bwrote = False
        self.shown = status_of(self)

    # A hand-run `bough serve --run`: no pidfile check before exec.
    atomic action ServeRunDirect:
        require self.b in ("none", "failed")
        self.b = "starting"
        self.bwrote = False
        self.shown = status_of(self)

    # launchd KeepAlive: the job's process exited (A, or a B that failed
    # to start), so it runs the binary again, throttled. Retries while
    # A still reaps would fail BListen's pidfile check and change
    # nothing, so the step waits for A to be gone. During an update this
    # is the old binary, respawned before restartServe's bootout.
    atomic fair action Respawn:
        require self.managed and self.a == "gone" and self.b in ("none", "failed")
        self.b = "starting"
        self.bwrote = False
        self.shown = status_of(self)

    # F1: Listen, then the pidfile, then NewSupervisor. The port is held
    # while A serves; the pidfile names a live A while A reaps. Either
    # way B exits with nothing spawned and nothing written.
    atomic fair action BListen:
        require self.b == "starting"
        if self.a == "serving" or (self.pf == "A" and self.a == "stopping"):
            self.b = "failed"
        else:
            self.pf = "B"
            self.b = "serving"
            # NewSupervisor re-queues S's task and drains it at once.
            if self.task == "queued" and self.cli == "none":
                self.bkid = True
                self.task = "started"
                self.turn = "open"
                self.bwrote = True
        self.shown = status_of(self)

    # ---- session S ----

    # The serve child's turn completes.
    atomic fair action ChildFinish:
        require self.turn == "open" and (self.akid or self.bkid) and self.cli != "turn"
        self.turn = "closed"
        self.shown = status_of(self)

    # POST /api/sessions/S/prompt to the serve that answers: ensure
    # adopts S with `-r S` when this serve has no child on it. Send takes
    # done or interrupted. F4: refused while a terminal holds S.
    atomic action WebPrompt:
        require self.shown in ("done", "interrupted") and self.cli == "none"
        if self.a == "serving":
            self.akid = True
        else:
            self.bkid = True
        self.turn = "open"
        self.shown = status_of(self)

    # `bough -r S` in a terminal. F4: refused while a serve child holds
    # S. The resume closes a dangling turn as cancelled.
    atomic action CliResume:
        require self.cli == "none" and not self.akid and not self.bkid
        self.cli = "idle"
        self.turn = "closed"
        self.shown = status_of(self)

    atomic action CliPrompt:
        require self.cli == "idle"
        self.cli = "turn"
        self.turn = "open"
        self.shown = status_of(self)

    atomic fair action CliFinish:
        require self.cli == "turn"
        self.cli = "idle"
        self.turn = "closed"
        self.shown = status_of(self)

    atomic action CliExit:
        require self.cli == "idle"
        self.cli = "none"
        self.shown = status_of(self)

# What the page shows for S, from the serve that answers (StatusOf with
# this serve's own lease, plus F4's cross-process lease).
def status_of(h):
    kid = False
    if h.a == "serving":
        kid = h.akid
    elif h.b == "serving":
        kid = h.bkid
    else:
        return "offline"
    if h.turn == "closed":
        return "done"
    if kid:
        return "running"
    if h.cli != "none":
        return "elsewhere"
    return "interrupted"

action Init:
    host = Host()

# One process appends to S's history at a time: two appenders fork it
# (catchUp's ConcurrentWriter), and two serve children are two agents.
always assertion OneWriterPerSession:
    n = 0
    if host.akid:
        n += 1
    if host.bkid:
        n += 1
    if host.cli != "none":
        n += 1
    return n <= 1

# Never two supervisors: a serve that is still reaping its children is
# still one.
always assertion OneSupervisor:
    return not (host.a != "gone" and host.b == "serving")

# The pidfile names the serving process, so `serve status` and the next
# `bough serve` see it.
always assertion PidfileNamesServer:
    return (host.a != "serving" or host.pf == "A") and (host.b != "serving" or host.pf == "B")

# A serve that fails to start (port held, pidfile live) spawned no child
# and wrote no meta.json.
always assertion FailedStartTouchedNothing:
    return host.b not in ("starting", "failed") or (not host.bwrote and not host.bkid)

# meta.json has one writer at a time: B writes it only once A is gone,
# so a live serve's saves are never overwritten by B's snapshot.
always assertion OneMetaWriter:
    return not host.bwrote or host.a == "gone"

# A turn running in a terminal is not shown interrupted (nor offered a
# Send that would start a second writer).
always assertion CliTurnNotInterrupted:
    return host.cli != "turn" or host.shown in ("elsewhere", "offline")

# Once the terminal is gone the session is the web's again: never shown
# as held elsewhere with no terminal.
always assertion LeaseFreesOnExit:
    return host.cli != "none" or host.shown != "elsewhere"

# After a stop and a start (or a crash, or an update, with the agent
# loaded) exactly one serve ends up serving, named by the pidfile.
always eventually assertion ServeComesBack:
    return not host.managed or (host.a == "serving" and host.b != "serving" and host.pf == "A") or (host.b == "serving" and host.a == "gone" and host.pf == "B")

# A terminal turn ends, and so the session is the web's again.
always eventually assertion CliTurnEnds:
    return host.cli != "turn"
