# Where a project thread's finish report lands: across main's own
# turns, main's history loss and re-mint, archiving main, and a serve
# restart. Checked against internal/serve children.go (CreateChild,
# drainQueue, childEventLocked, report, requeueLocked), notify.go
# (notifyFrom), supervisor.go (Main, MainID, SetArchived, loadMeta) and
# projects.go (messageProject).
#
# One project, its main thread and one thread started from the page.
#
# main is main's process: "idle" (a live child, no turn), "turn" (a live
# child mid-turn), "down" (no child: after a restart, or killed by an
# archive), "gone" (the recorded id's history file is gone; MainID says
# no main). archived is main's meta flag, separate from the process
# because SetArchived sets it BEFORE it kills the child: between the
# two, main is archived and still alive.
#
# gen is main's id: Main() re-mints a fresh one when the recorded one's
# history file is gone. tparent is the gen the thread's SpawnedBy names:
# CreateChild copies it once and nothing ever rewrites it.
#
# thread: "none", "queued" (behind the running cap, its task persisted
# in meta.json), "running" (a turn open with a live child), "pending"
# (the turn closed; the report goroutine has not yet run notifyFrom),
# "done" (report() ran for this turn), "interrupted" (a turn left open
# by a restart: no child, derived status interrupted).
#
# landed counts the current turn's report in the conversation MainID
# shows; dropped is a report notifyFrom threw away (no parent file).
# mem/disk are whether Reported covers the current turn in memory and in
# meta.json: report() sets it and saves best-effort.
#
# slot is another agent holding the one running slot (the cap is folded
# to 1: the thread is queued exactly when the slot is held).
#
# Gaps the code has (each is a require below that keeps the spec to
# what the code gets right, and a mutation that drops it fails the
# assertion it guards; see the notes of this flow's report):
#   G1 re-mint under a live thread: tparent stays the old id, notifyFrom
#      stats a missing file and returns ErrUnknownSession, report()
#      ignores it -> the report is dropped. LoseMainHistory needs no
#      thread.
#   G2 restart with a report pending: report() is a goroutine and
#      nothing re-scans finished children at startup, so a turn that
#      closed just before Stop is never reported. ServeRestart needs no
#      pending report.
#   G3 Reported saved best-effort: after a failed save and a restart,
#      a later trigger for the SAME closed turn (a respawned thread
#      child that exits before its input lands: trigger "exit",
#      lastTurn's closing seq > the stale Reported) reports it again.
#      RespawnDies needs the save to have landed.
#   G4 SetArchived sets the flag and only then kills: a report in that
#      window is written to the idle child's stdin and wakes it into a
#      turn. Report needs main not both archived and idle-alive.
#   Not an invariant here: a report to an archived, down main is
#   appended to its file (landed) but the row is hidden and a notice is
#   not a finished turn, so nothing marks it unseen.

role Project:
    action Init:
        self.main = "idle"
        self.archived = False
        self.gen = 0
        self.tparent = 0
        self.thread = "none"
        self.landed = 0
        self.dropped = False
        self.mem = False
        self.disk = False
        self.slot = False
        self.woke = False

    # --- main's own life.

    atomic action MessageProject:
        # messageProject: Main(slug) (re-mint if gone), unarchive, Send
        # (ensure spawns a child when there is none). Not mid-turn (that
        # is steering, another flow) and not in the archive's own window.
        require self.main in ("idle", "down", "gone")
        require not (self.archived and self.main == "idle")
        if self.main == "gone":
            self.gen = self.gen + 1
            # The new main's conversation holds nothing of the old one.
            self.landed = 0
        self.archived = False
        self.main = "turn"

    atomic fair action MainTurnEnd:
        require self.main == "turn"
        self.main = "idle"

    atomic action ArchiveMain:
        # The sidebar's archive of main: SetArchived writes the flag,
        # then kills. The project's archive kills first (EndProject) and
        # is ArchiveMain + ArchiveKill with nothing between.
        require self.main in ("idle", "turn", "down") and not self.archived
        self.archived = True

    atomic fair action ArchiveKill:
        require self.archived and self.main in ("idle", "turn")
        self.main = "down"

    atomic action LoseMainHistory:
        # G1: only with no thread in the project.
        require self.main in ("idle", "down") and not self.archived
        require self.thread == "none" and self.gen < 1
        self.main = "gone"
        self.landed = 0

    # --- the thread.

    atomic action StartThread:
        # 'New thread' / 'Start thread': Main() then CreateChild with
        # SpawnedBy = main's current id. Queued when the cap is full.
        require self.thread == "none" and self.main in ("idle", "turn")
        require not self.archived
        self.tparent = self.gen
        self.landed = 0
        self.dropped = False
        self.mem = False
        self.disk = False
        if self.slot:
            self.thread = "queued"
        else:
            self.thread = "running"

    atomic action ThreadMessage:
        # A new turn in the thread (ensure respawns it after a restart).
        require self.thread in ("done", "interrupted") and not self.slot
        self.thread = "running"
        self.landed = 0
        self.dropped = False
        self.mem = False
        self.disk = False

    atomic action ThreadFinish:
        # done, or the person's Stop (cancelled): both close the turn and
        # childEventLocked starts report() in a goroutine.
        require self.thread == "running"
        self.thread = "pending"

    atomic fair<strong> action Report:
        # report(): lastTurn off disk, Reported = key, save, notifyFrom.
        # Strong: main flickers through the archive window (G4) forever
        # only in a model; the goroutine runs in real time.
        # G4: not into main's archive window.
        require self.thread == "pending" and not self.mem
        require not (self.archived and self.main == "idle")
        self.mem = True
        self.disk = True
        self.thread = "done"
        if self.tparent != self.gen or self.main == "gone":
            # No history file under the id SpawnedBy names.
            self.dropped = True
        elif self.main == "idle":
            # A {"notice"} line wakes the idle child into a turn.
            self.landed = self.landed + 1
            self.main = "turn"
            if self.archived:
                self.woke = True
        else:
            # Mid-turn: queued on stdin; down: appended to the file for
            # the next mount. Either way it is in main's conversation.
            self.landed = self.landed + 1

    atomic action ReportSaveFails:
        # report() with saveMetaLocked failing: the notice still goes
        # out, Reported is only in memory.
        require self.thread == "pending" and not self.mem
        require not (self.archived and self.main == "idle")
        require self.tparent == self.gen and self.main != "gone"
        self.mem = True
        self.disk = False
        self.thread = "done"
        self.landed = self.landed + 1
        if self.main == "idle":
            self.main = "turn"

    atomic action RespawnDies:
        # A thread child started for a closed turn exits before it
        # records an input: trigger "exit", key = the old closing seq,
        # compared with Reported. G3: only once the save landed.
        require self.thread == "done" and self.disk
        if not self.mem:
            self.mem = True
            self.landed = self.landed + 1

    atomic action ArchiveThread:
        require self.thread in ("done", "interrupted")
        self.thread = "none"

    # --- another agent on the running cap.

    atomic action SlotTake:
        require not self.slot and self.thread != "queued"
        self.slot = True

    atomic fair action SlotFree:
        # Its turn ends; drainQueue starts the queued thread at once.
        require self.slot
        self.slot = False
        if self.thread == "queued":
            self.thread = "running"

    # --- serve restarts (Stop + NewSupervisor).

    atomic action ServeRestart:
        # Every child dies; meta.json is re-read (Reported from disk),
        # the queued task requeued and drained with the running map
        # empty. G2: not with a report pending.
        require self.thread != "pending"
        if self.main in ("idle", "turn"):
            self.main = "down"
        self.slot = False
        self.mem = self.disk
        if self.thread == "running":
            self.thread = "interrupted"
        elif self.thread == "queued":
            self.thread = "running"

action Init:
    project = Project()

# A finished thread's report is in the conversation MainID shows exactly
# once: not dropped, not duplicated.
always assertion ReportLandsOnce:
    if project.thread == "done":
        return project.landed == 1 and not project.dropped
    return project.landed <= 1 and not project.dropped

# Any thread still reporting names the main MainID shows.
always assertion SpawnedByIsCurrentMain:
    return project.thread == "none" or project.tparent == project.gen

# A report never wakes a main that is being archived into a turn.
always assertion NoticeNeverWakesArchivingMain:
    return not project.woke

# A queued thread is only ever behind a held slot: once the slot is
# free (a restart frees it too), the drain has started it.
always assertion QueuedOnlyBehindSlot:
    return project.thread != "queued" or project.slot

# Every finished turn is eventually reported.
always eventually assertion ThreadReported:
    return project.thread != "pending"

# A thread queued (before a restart or not) eventually runs.
always eventually assertion QueuedThreadRuns:
    return project.thread != "queued"
