# ~/.bough/env is read once at startup and never overrides a variable
# already in the process env (envfile.go applyEnv). So a shell that still
# exports a stale key beats an edited file, an edit while serve runs is
# not seen until restart, and children (sessions, orbs) inherit whatever
# serve's process env held when it started.
#
# shell: the key exported in the launching shell ("" unset, else "stale").
# file: the key in ~/.bough/env. effective: serve's process env value.
# child: the key the latest child session saw.

role Env:
    action Init:
        self.shell = "unset"
        self.file = "none"
        self.running = False
        self.effective = "unset"
        self.child = "none"
        self.launched = "unset"

    atomic action EditFile:
        require self.file != "new"
        self.file = "new"

    atomic action ExportStale:
        require self.shell == "unset"
        self.shell = "stale"

    atomic action UnsetShell:
        require self.shell == "stale"
        self.shell = "unset"

    atomic action Start:
        require not self.running
        self.running = True
        self.launched = self.shell
        if self.shell != "unset":
            self.effective = self.shell
        elif self.file != "none":
            self.effective = self.file
        else:
            self.effective = "unset"

    atomic action Stop:
        require self.running
        self.running = False
        self.effective = "unset"
        self.child = "none"

    atomic action Spawn:
        require self.running
        self.child = self.effective

action Init:
    env = Env()

always assertion ChildSeesServeEnv:
    return env.child == "none" or env.running

always assertion ShellBeatsFile:
    return not (env.running and env.launched == "stale") or env.effective == "stale"

always assertion EffectiveKnown:
    return env.effective in ["unset", "stale", "old", "new"] and (not env.running or env.effective != "old")
