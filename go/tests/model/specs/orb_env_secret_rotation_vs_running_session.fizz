# A credential in the orb env (project.yml's env:, baked into the
# container's run spec by internal/orb's baseEnv/Successor.build) is
# rotated on the host while a session's orb container is already running
# with the old value injected. restart.go's request() kicks the build
# (Successor, which bakes the CURRENT project env into the new spec) the
# instant a restart is asked, on its own goroutine, well before the swap
# waits for the turn to close (once(): load, build, waitIdle, swap): the
# value that lands is whichever the host had at REQUEST time, not at
# swap time, so a rotation landing after the request but before the swap
# is never picked up by that restart — the next request is what would see
# it. pendingSecret is that snapshot, taken once by RequestRestart and
# carried until the swap applies it; a running orb otherwise keeps the
# value it started with no matter how many times the host value changes
# after that, until a restart's swap actually replaces the container. A
# restart requested mid-turn (turnOpen) has its build run regardless, and
# only the swap itself is held until the turn closes.
#
# hostSecret is a generation counter, not a real secret value: 0 is the
# value the orb started with, and each RotateSecret bumps it, standing in
# for a new credential landing in the host env.

role Orb:
    action Init:
        self.hostSecret = 0
        self.injectedSecret = 0
        self.restartPending = False
        self.turnOpen = False
        self.pendingSecret = 0

    atomic action RotateSecret:
        require self.hostSecret < 2
        self.hostSecret = self.hostSecret + 1

    atomic action RequestRestart:
        require not self.restartPending
        self.restartPending = True
        self.pendingSecret = self.hostSecret

    atomic action OpenTurn:
        require not self.turnOpen
        self.turnOpen = True

    atomic action CloseTurn:
        require self.turnOpen
        self.turnOpen = False
        if self.restartPending:
            self.injectedSecret = self.pendingSecret
            self.restartPending = False

    atomic action ApplySwap:
        require self.restartPending and not self.turnOpen
        self.injectedSecret = self.pendingSecret
        self.restartPending = False

action Init:
    orb = Orb()

# A swap never injects a value newer than what is actually on the host at
# swap time: injectedSecret can only be what a completed rotation put in
# hostSecret, never ahead of it — no phantom rotation.
always assertion InjectedNeverAheadOfHost:
    return orb.injectedSecret <= orb.hostSecret

# A swap only ever happens with the turn closed: nothing changes the
# container out from under a running turn.
always assertion NoSwapMidTurn:
    return not orb.turnOpen or orb.injectedSecret <= orb.hostSecret
