---
# Every path ends in a quiet thread (a finished turn, a lost prompt, a
# landed command): that is rest, not a deadlock.
deadlock_detection: false
---

# The first prompt of a create, from the 201 to the entry the child
# records for it: its kind (plain, multi-line, /command, !shell), a child
# that dies before recording it, a Stop in that gap, and a second send.
# session_create ends where this starts: it models the prompt as text
# that always lands.
#
# Code (line numbers at the time of writing):
# - app.tsx App start(): on 201, setPending({text, after: 0}) for any
#   non-empty prompt (~5623).
# - app.tsx Thread (~4258-4297): a pending lands by the count rule
#   (each input after `after` claims one, oldest first) or by sameText;
#   isCmd is /^\/[a-z]/ only, landed by a "command" line with the same
#   verb. `live` = running or any non-steer pending unlanded.
# - supervisor.go createWithID (~453-495): claim, writePrompt, 201.
#   writePrompt (~1049) marks ch.unread only for lines not starting
#   with "/" or "!"; write wraps a multi-line prompt as one
#   {"prompt": ...} line. Interrupt (~1103) holds while unread && !inTurn,
#   released by the child's input/first output or holdLimit (20 s);
#   otherwise SIGINTs, which ends a headless child (see stop_interrupt).
# - plugins/ui/headless.go: "/" lines go to hlDispatch, "!" lines to
#   hlBang; both record "command"/"system", never "input".
# - history.go List (~473): the title is the first line of the first
#   input; serve's Row.empty is !hasInput (signals.go), and the sidebar
#   leaves out a local row that is empty and not live (app.tsx ~375).
#
# Where the code disagrees with the mapped model:
# - "posted" and "written (unread)" are one state from the page's side:
#   Create writes the prompt before it answers 201, so the preview
#   appears with the line already on the child's stdin. unread and the
#   hold are derived here (a plain/multi-line prompt with no record and a
#   live child), not fields: nothing outside the supervisor can read them.
# - A "!" first prompt records a command, like "/", but the page's isCmd
#   knows only "/": its preview waits for an input that never comes and
#   stays "Sending…" with a live child (bang_stuck below).
# - "Not sent" is never reached from a lost first prompt: nothing on the
#   page watches the child's exit, and swallowedByStop needs a done or
#   cancelled that a child killed in the gap never writes. The preview
#   leaves only when a later input claims it by the count rule
#   (RecordSecond) or a reload drops the in-memory pending (Reload).
# - A Stop in the gap of a "/" or "!" first prompt is not held (unread is
#   never set for them): the SIGINT reaches a child that has not read the
#   line, the child exits and the line dies unrecorded.
# - The page clears its stop state only when `live` goes false. A stuck
#   preview keeps it true, so a "Stopping" left by a dead child carries
#   over into the turn a second send starts (reachable below, not
#   asserted away).
#
# Fields (First role):
#   kind      the first prompt typed: none | plain | multiline | slash | bang
#   child     none | live (holds the lease) | gone (exited)
#   recorded  what the child recorded for the first prompt: none | input | command
#   inputs    input entries in the transcript
#   turn      the last turn: none | running | done | cancelled
#   sending   the first prompt's "Sending…" preview is on screen
#   stopping  the page's stop state: "" | stopping | failed ("Retry stop")
#   second    a second message: none | sent | recorded
#   title     the row's title: none (Untitled) | first | second (whose first line)

role First:
    action Init:
        self.kind = "none"
        self.child = "none"
        self.recorded = "none"
        self.inputs = 0
        self.turn = "none"
        self.sending = False
        self.stopping = ""
        self.second = "none"
        self.title = "none"

    # The palette's Start row with each kind of text. Create has spawned
    # the child, claimed it and written the line; the page shows the
    # preview and opens the thread.
    atomic action StartPlain:
        require self.kind == "none"
        self.kind = "plain"
        self.child = "live"
        self.sending = True

    # A shift+return prompt: written as one {"prompt": ...} line.
    atomic action StartMultiline:
        require self.kind == "none"
        self.kind = "multiline"
        self.child = "live"
        self.sending = True

    atomic action StartSlash:
        require self.kind == "none"
        self.kind = "slash"
        self.child = "live"
        self.sending = True

    atomic action StartBang:
        require self.kind == "none"
        self.kind = "bang"
        self.child = "live"
        self.sending = True

    # The child reads the first line and records it. A plain/multi-line
    # prompt is one input entry and starts a turn; a Stop held for it is
    # released now and cancels that turn, and the child exits. A "/"
    # line lands its preview by cmdLanded; a "!" line records the same
    # kind of command, which the page does not look for.
    atomic fair action Record:
        require self.child == "live" and self.recorded == "none"
        require self.kind != "none" and self.second == "none"
        if self.kind in ("plain", "multiline"):
            self.recorded = "input"
            self.inputs = self.inputs + 1
            self.title = "first"
            self.sending = False
            if self.stopping == "stopping":
                self.turn = "cancelled"
                self.child = "gone"
                self.stopping = ""
            else:
                self.turn = "running"
        elif self.kind == "slash":
            self.recorded = "command"
            self.sending = False
        else:
            self.recorded = "command"

    # The child dies after the 201 and before recording the line (a
    # crash, an OOM kill): its history has the meta and nothing else.
    atomic action ChildExitsBeforeRecord:
        require self.child == "live" and self.recorded == "none"
        require self.kind != "none" and self.second == "none"
        self.child = "gone"

    atomic fair action Finish:
        require self.turn == "running"
        self.turn = "done"
        if not self.sending:
            self.stopping = ""

    # Esc / Stop while the page thinks something is live: a preview on
    # its way or a running turn. Not while a second send is in the gap
    # (steer_queue and stop_interrupt cover that).
    atomic action Stop:
        require self.stopping == "" and self.second != "sent"
        require self.sending or self.turn == "running"
        if self.child != "live":
            # No child holds the lease: 404, "Retry stop".
            self.stopping = "failed"
        elif self.turn == "running":
            # SIGINT cancels the turn; the headless child then exits, and
            # with nothing live the page clears its stop state.
            self.turn = "cancelled"
            self.child = "gone"
        elif self.recorded == "none" and self.kind in ("plain", "multiline"):
            # Held until the child takes the prompt, or holdLimit.
            self.stopping = "stopping"
        else:
            # A "/" or "!" line not yet read, or an idle child after a
            # "!" whose preview is stuck: SIGINT at once, the child exits.
            self.child = "gone"
            self.stopping = "stopping"

    # holdLimit passes before the child reads the line: the SIGINT
    # reaches a child with nothing to cancel, which exits, and the line
    # dies with it. No input, no turn.
    atomic fair action HoldExpires:
        require self.stopping == "stopping" and self.child == "live"
        require self.recorded == "none" and self.kind in ("plain", "multiline")
        require self.second == "none"
        self.child = "gone"

    # A second message, once the first is not in its gap. With no child
    # the supervisor respawns one (-r). While the first preview is still
    # up the page sends it as a steer; the child is idle, so it runs as
    # a prompt either way.
    atomic action SendSecond:
        require self.kind != "none" and self.second == "none"
        require self.turn != "running"
        require self.child != "live" or self.recorded != "none"
        self.second = "sent"
        self.child = "live"

    # The second message's input entry lands. By the count rule it also
    # claims the first preview, recorded or not: a lost first prompt
    # leaves the screen with no "Not sent".
    atomic fair action RecordSecond:
        require self.second == "sent"
        self.second = "recorded"
        self.inputs = self.inputs + 1
        self.turn = "running"
        self.sending = False
        if self.title == "none":
            self.title = "second"

    # A reload: pending previews are App state and are dropped; a stop
    # state starts clear. The transcript and the server are unchanged.
    atomic action Reload:
        require self.sending or self.stopping != ""
        require self.second != "sent"
        self.sending = False
        self.stopping = ""

action Init:
    first = First()

# Each recorded prompt is exactly one input entry: a multi-line first
# prompt is never split into one entry per line.
always assertion OnePromptOneEntry:
    want = 0
    if first.recorded == "input":
        want = want + 1
    if first.second == "recorded":
        want = want + 1
    return first.inputs == want

# The preview gives way to the recorded entry: never both on screen.
always assertion PreviewGivesWay:
    return not (first.sending and (first.recorded == "input" or first.second == "recorded"))

# A recorded first prompt names the session by its first typed line.
always assertion TitleIsFirstLine:
    return first.recorded != "input" or first.title == "first"

# A turn runs only for a recorded input: a "/" or "!" line starts none,
# and a lost first prompt starts none of its own.
always assertion NoTurnWithoutInput:
    return first.turn == "none" or first.inputs > 0

# A Stop in the gap cancels at most the turn it was held for: a held
# stop is never left armed on a turn that is running.
always assertion HeldStopNeverOnARunningTurn:
    return not (first.turn == "running" and first.stopping == "stopping" and first.second == "none")

# An interrupt held in the gap is applied once the line is read, or
# dropped with the child when holdLimit passes; it never waits forever.
always eventually assertion HeldStopResolves:
    held = first.stopping == "stopping" and first.child == "live" and first.second == "none"
    return not (held and first.recorded == "none" and first.kind in ("plain", "multiline"))

# While its child lives, a plain, multi-line or "/" preview lands.
# ("!" is excluded: its preview never lands today, see the header.)
always eventually assertion LivePreviewLands:
    return not (first.sending and first.child == "live" and first.kind != "bang")

# A running turn ends.
always eventually assertion TurnEnds:
    return first.turn != "running"
