{
  "name": "bough-control-room",
  "private": true,
  "version": "0.0.1",
  "description": "The bough serve control room UI. Built with bun into dist/app.js, which is committed and go:embed-ed.",
  "scripts": {
    "build": "bun build src/main.tsx --outfile=dist/app.js --minify --define:process.env.NODE_ENV='\"production\"'",
    "dev": "bun build src/main.tsx --outfile=dist/app.js --watch",
    "design:check": "node design/check.mjs",
    "design:sync": "node design/check.mjs --write",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "build:types": "tsc -p tsconfig.ds.json",
    "typecheck": "tsc --noEmit --jsx react-jsx --module esnext --moduleResolution bundler --target es2022 --skipLibCheck --strict src/*.tsx src/*.ts src/stories/*.tsx src/stories/*.ts",
    "check": "bun run typecheck && bun run design:check"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@types/dompurify": "^3.2.0",
    "@types/react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "types": "types/ds-entry.d.ts"
}
