{
  "name": "bough-control-room",
  "private": true,
  "version": "0.0.1",
  "description": "The bough serve control room UI. Built with bun into dist/app.js, which is committed and go:embed-ed.",
  "scripts": {
    "build": "bun run build:css && bun run build:js",
    "build:css": "tailwindcss -i src/app.css -o dist/tw.css --minify",
    "build:js": "bun build src/main.tsx --outfile=dist/app.js --minify --production --define:process.env.NODE_ENV='\"production\"'",
    "dev": "bun build src/main.tsx --outfile=dist/app.js --watch",
    "design:check": "node design/check.mjs",
    "design:sync": "node design/check.mjs --write",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "build:types": "tsc -p tsconfig.ds.json",
    "typecheck": "tsc -p tsconfig.json",
    "check": "bun run typecheck && bun run design:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.46.0",
    "marked": "^18.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "types": "types/ds-entry.d.ts"
}
