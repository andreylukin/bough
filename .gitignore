# cargo build output
/target

# OS
.DS_Store
__pycache__/

# npm working tree — only ever populated by scripts/build-chart-bundle.sh, which
# vendors its output into the crate. A clean checkout never needs it.
node_modules/

# leftovers of the deleted TypeScript tree (ahe run outputs, vendored bun builds);
# safe to delete from your checkout by hand.
ahe/
.bough-bun/
.bough-bun-linux
.bough-bun-linux-musl

# local harness state (worktrees, session settings)
.claude/

# the dev profile: this checkout run against its own data root (make dev)
/.dev/

# prebuilt linux bough for the Harbor/terminal-bench adapter (bench/harbor)
bench/harbor/dist/
/target-linux
