# The built binary (repo root and go/, since both are build targets).
/bough
/go/bough

# OS and editor droppings.
.DS_Store
__pycache__/

# Local harness state: worktrees, session settings, scratch shots.
/.dev/
.claude/
.shots-tmp/

# Rapid property-test failure replays.
**/testdata/rapid/

# Leftovers of the deleted TypeScript tree: ahe run outputs and the
# vendored bun builds. Safe to delete from your checkout by hand.
ahe/
.bough-bun/
.bough-bun-linux
.bough-bun-linux-musl
node_modules/

# Leftovers of the deleted Rust tree: bench outputs and the prompt
# tuner's workspace.
bench/pier/
bench/tune/
bough_path(*

# Prebuilt linux bough for the Harbor/terminal-bench adapter.
bench/harbor/dist/

# tmux debug logs and the unevaluated-expr sqlite artifact (2026-09-01);
# these never belong in the tree.
tmux-*.log
