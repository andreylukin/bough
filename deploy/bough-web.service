[Unit]
Description=bough web (browser TUI, tailnet-only)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=bough
WorkingDirectory=/home/bough
Environment=HOME=/home/bough
EnvironmentFile=-/home/bough/.bough/env
# Bind loopback only: the server has no auth, tailscale serve fronts it.
ExecStart=/home/bough/.local/bin/bough --web 127.0.0.1:7681
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
