{
  "projectId": "49994de9-4eaf-4559-b637-00d424ce3396",
  "shape": "storybook",
  "pkg": "bough-control-room",
  "globalName": "BoughWeb",
  "storybookConfigDir": "go/internal/serve/web/.storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "buildCmd": "cd go/internal/serve/web && bun run build && bun run build:types",
  "entry": "go/internal/serve/web/ds-entry.ts",
  "srcDir": "go/internal/serve/web/src",
  "cssEntry": "design/bough.css",
  "titleMap": {
    "Transcript": "TurnView",
    "Shell": "App",
    "Foundations": null,
    "Live": "StreamView"
  },
  "overrides": {
    "App": {
      "cardMode": "column",
      "viewport": "1440x900"
    },
    "StatusMark": {
      "cardMode": "column"
    },
    "Thread": {
      "cardMode": "column",
      "viewport": "1280x860"
    },
    "Palette": {
      "cardMode": "single",
      "primaryStory": "OneWord",
      "viewport": "1000x620"
    },
    "StreamView": {
      "cardMode": "column",
      "viewport": "1100x700"
    },
    "HooksView": {
      "cardMode": "column",
      "viewport": "1200x860"
    },
    "ContextView": {
      "cardMode": "column",
      "viewport": "1200x820"
    },
    "ProjectsView": {
      "cardMode": "column",
      "viewport": "1200x820"
    },
    "TurnView": {
      "cardMode": "column"
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}
