#!/usr/bin/env bash
# bough server manager: setup | start | kill | restart | update | status | logs | run
# Runs the server as a launchd user service (starts at login, restarts on crash).
# There is no file watcher: editing code in the repo never restarts the server —
# changes only land on an explicit `bough restart` or `bough update`. Sources
# ~/.bough/env for ANTHROPIC_API_KEY / BOUGH_* settings. Installed onto PATH as
# a symlink by scripts/setup.sh.
#
# Runs the Rust build at `target/release/bough`; `make release` builds it.
set -euo pipefail

# Resolve the repo root through the ~/.local/bin symlink (bash 3.2 compatible).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"

# Where the toolchain might be, widened ONCE for every subcommand below.
#
# The binary is ours, but a code-mode program still needs a JS runtime (`bun`, else
# `node`) for the sidecar, and `update` needs `cargo`. None of them reliably reach
# launchd, which starts with a bare environment: that gap showed up as the server
# failing to start with nothing but a "command not found" in the log, on a machine
# where the same command worked fine in the terminal.
#
# Prepended only when the directory exists and is not already on PATH, so this
# cannot reorder a PATH the user deliberately arranged.
# WHICH OS. Every platform-specific decision below routes through this and
# nothing else, so "does bough run on Linux" is a question about four functions
# (`svc_*`) rather than about the whole script.
OS="$(uname -s)"

for d in "/opt/homebrew/bin" "/usr/local/bin" "$HOME/.local/bin" "$HOME/.bun/bin" "$HOME/.cargo/bin"; do
  case ":$PATH:" in
    *":$d:"*) ;;
    *) [ -d "$d" ] && PATH="$PATH:$d" ;;
  esac
done
export PATH

# ---------------------------------------------------------------------------
# THE BINARY. Everything the user runs — the server, the TUI, `exec`, the CLIs —
# is this one build.
#
# The lifecycle verbs stay HERE, in the script, rather than in the symlink on
# PATH: `start`, `kill`, `restart`, `status`, `logs` and `update` are
# launchd/systemd verbs the binary has no equivalent for. Pointing PATH at the
# binary would throw the lifecycle away.
RS_BIN="$ROOT/target/release/bough"

# Says which binary is missing and how to get it, rather than failing as "no such
# file or directory" from a dozen call sites. A fresh clone has no `target/`.
require_rust() {
  [ -x "$RS_BIN" ] && return 0
  echo "error: the bough build is missing at $RS_BIN" >&2
  echo "  build it with:  make -C $ROOT release" >&2
  exit 1
}

LABEL="com.bough.server"

# The server runs as you, in your own account, via a per-user LaunchAgent.
# State lives under ~/.bough, unless the caller says otherwise. It used to be a bare
# assignment, which OVERWROTE an exported BOUGH_HOME one line after the header comment
# promises this script honours `BOUGH_*` settings — so `BOUGH_HOME=/tmp/x bough` silently
# attached to the main install instead of the profile the user asked for.
BOUGH_HOME="${BOUGH_HOME:-$HOME/.bough}"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"

# The Linux equivalents. A systemd USER unit, not a system one: bough runs as you,
# in your account, reading your keys — the same property the LaunchAgent has, and
# the reason neither of them needs root.
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
UNIT="$UNIT_DIR/bough.service"
# The last resort. Plenty of Linux boxes have no user systemd at all — containers,
# WSL1, minimal images — and "bough only works under systemd" would be a worse
# answer than a pidfile. `svc_*` falls back to this when systemctl cannot answer.
PIDFILE="$BOUGH_HOME/server.pid"

case "$OS" in
  Darwin) SERVICE_DESC="launchd service" ;;
  *) if systemctl --user show-environment >/dev/null 2>&1; then
       SERVICE_DESC="systemd user service"
     else
       SERVICE_DESC="background process"
     fi ;;
esac

LOG_FILE="$BOUGH_HOME/server.log"
ENV_FILE="$BOUGH_HOME/env"

mkdir -p "$BOUGH_HOME"
if [ -f "$ENV_FILE" ] && [ -r "$ENV_FILE" ]; then
  # THE CALLER'S ENVIRONMENT WINS OVER THE FILE. `set -a` + `.` exports every assignment
  # in the file over whatever was already exported, so `BOUGH_PORT=4327 bough` connected
  # to 4321 anyway — the file's value beat the flag, which is backwards for a config file
  # and gave no sign it had happened. Snapshotted and restored around the source, for the
  # settings the header comment actually documents.
  _pre_port="${BOUGH_PORT-}"
  _pre_model="${BOUGH_MODEL-}"
  _pre_effort="${BOUGH_EFFORT-}"
  set -a
  # shellcheck source=/dev/null
  . "$ENV_FILE"
  set +a
  # `if`, not `[ … ] && …`: under `set -e` a failing test as the last command of this
  # block would abort the script, which is a spectacular way to break `bough` for anyone
  # who has not set the variable.
  if [ -n "$_pre_port" ]; then BOUGH_PORT="$_pre_port"; fi
  if [ -n "$_pre_model" ]; then BOUGH_MODEL="$_pre_model"; fi
  if [ -n "$_pre_effort" ]; then BOUGH_EFFORT="$_pre_effort"; fi
  unset _pre_port _pre_model _pre_effort
fi
PORT="${BOUGH_PORT:-4321}"

# Always exits 0: with pipefail, lsof's exit 1 on "no listener" would otherwise
# propagate through bare assignments and trip errexit.
# lsof first because it is what macOS ships; ss is what a minimal Linux image
# ships instead. Either answer is the same fact — who is listening on $PORT —
# and a box with neither falls back to the pidfile rather than to a wrong "no".
server_pid() {
  if command -v lsof >/dev/null; then
    lsof -ti "tcp:$PORT" -sTCP:LISTEN 2>/dev/null | head -n1
  elif command -v ss >/dev/null; then
    ss -lptnH "sport = :$PORT" 2>/dev/null |
      grep -o 'pid=[0-9]*' | head -n1 | cut -d= -f2
  elif [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
    cat "$PIDFILE"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# The service layer. Three backends, one interface — everything below calls
# `svc_*` and never a platform's own verb, which is what keeps the lifecycle
# commands (`start`, `kill`, `restart`) identical on every OS.
# ---------------------------------------------------------------------------

have_systemd() { systemctl --user show-environment >/dev/null 2>&1; }

service_loaded() {
  case "$OS" in
    Darwin) launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1 ;;
    *)
      if have_systemd; then
        systemctl --user is-active --quiet bough.service
      else
        [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
      fi
      ;;
  esac
}

write_unit() {
  mkdir -p "$UNIT_DIR"
  tee "$UNIT" >/dev/null <<EOF
[Unit]
Description=bough server
After=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash $ROOT/scripts/bough run
# Matches the LaunchAgent's KeepAlive{SuccessfulExit=false}: come back from a
# crash, stay down after a clean exit, so an unconfigured machine (no API key,
# which exits 0) does not relaunch-loop.
Restart=on-failure
StandardOutput=append:$LOG_FILE
StandardError=append:$LOG_FILE

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  return 0
}

# Install/refresh the service definition. Always rewritten rather than written
# once: a stale definition (a moved repo, a log path left by another profile)
# otherwise survives every restart, which is a bug this script has already had.
svc_write() {
  case "$OS" in
    Darwin) write_plist ;;
    *) have_systemd && write_unit || true ;;
  esac
}

svc_start() {
  case "$OS" in
    Darwin)
      launchctl enable "$DOMAIN/$LABEL" 2>/dev/null || true
      if service_loaded; then
        launchctl kickstart "$DOMAIN/$LABEL"
      else
        launchctl bootstrap "$DOMAIN" "$PLIST"
      fi
      ;;
    *)
      if have_systemd; then
        systemctl --user enable --now bough.service
      else
        # No user systemd. Detached, output to the same log every other backend
        # writes, pid recorded so `kill` and `status` still have an answer.
        mkdir -p "$BOUGH_HOME"
        nohup /bin/bash "$ROOT/scripts/bough" run >>"$LOG_FILE" 2>&1 &
        echo $! >"$PIDFILE"
      fi
      ;;
  esac
}

svc_stop() {
  case "$OS" in
    Darwin)
      # disable makes the stop stick across logins (start re-enables). bootout can
      # report non-zero while the teardown is still in flight — the caller's wait
      # loop is the real confirmation.
      launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
      launchctl disable "$DOMAIN/$LABEL" 2>/dev/null || true
      ;;
    *)
      if have_systemd; then
        systemctl --user disable --now bough.service 2>/dev/null || true
      elif [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null || true
        rm -f "$PIDFILE"
      fi
      ;;
  esac
}

svc_restart() {
  case "$OS" in
    Darwin) launchctl kickstart -k "$DOMAIN/$LABEL" ;;
    *)
      if have_systemd; then
        systemctl --user restart bough.service
      else
        svc_stop
        svc_start
      fi
      ;;
  esac
}

# Up = any HTTP answer on the port (200 without auth, 401 with).
is_up() {
  curl -sf -o /dev/null -m 2 "http://127.0.0.1:$PORT/sessions" ||
    [ "$(curl -s -o /dev/null -m 2 -w '%{http_code}' "http://127.0.0.1:$PORT/sessions")" = 401 ]
}

# Per-user LaunchAgent. KeepAlive on SuccessfulExit=false: relaunch after a crash,
# stay down after a clean exit (so a missing API key doesn't loop). No WatchPaths —
# on purpose.
# THE LAUNCHAGENT BELONGS TO THE DEFAULT PROFILE, AND ONLY TO IT. `write_plist` stamps
# this invocation's paths into the ONE plist every profile shares, so
# `BOUGH_HOME=/tmp/x bough start` silently repointed the login service's log path at a
# scratch directory — the running server was fine, and the next login would have come up
# pointing into a directory that no longer existed. Found by doing exactly that on a walk,
# to my own install.
require_default_profile() {
  if [ "$BOUGH_HOME" != "$HOME/.bough" ]; then
    echo "error: the $LABEL $SERVICE_DESC is the DEFAULT profile's ($HOME/.bough)." >&2
    echo "  \`bough $1\` with BOUGH_HOME=$BOUGH_HOME would repoint your login service." >&2
    echo "  Run this profile in the foreground instead:" >&2
    echo "  BOUGH_HOME=$BOUGH_HOME BOUGH_PORT=$PORT bough run" >&2
    exit 1
  fi
  return 0
}

write_plist() {
  mkdir -p "$HOME/Library/LaunchAgents"
  tee "$PLIST" >/dev/null <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$ROOT/scripts/bough</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>$LOG_FILE</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict>
</plist>
EOF
  return 0
}

wait_up() {
  local i
  for i in $(seq 1 30); do
    if is_up; then
      echo "up (pid $(server_pid)) — http://127.0.0.1:$PORT"
      return 0
    fi
    sleep 0.5
  done
  echo "error: server did not answer on port $PORT within 15s" >&2
  # THE LOG, OR WHY THERE IS NONE. This used to end with "— last log lines:" and then
  # `tail` a file that does not exist, printing nothing: the message promised the useful
  # half and delivered an empty line, which reads as truncated output rather than as a
  # missing file. An empty log is itself the clue — the process never got far enough to
  # write one.
  if [ -s "$LOG_FILE" ]; then
    echo "last log lines:" >&2
    tail -n 20 "$LOG_FILE" >&2
  else
    echo "(no log at $LOG_FILE — the server process never started)" >&2
  fi
  # ONE SERVICE PER USER. The LaunchAgent is a single label, so a second profile —
  # `BOUGH_HOME=… BOUGH_PORT=… bough` — asks launchd to start something it already has
  # running for the main install, and times out here with nothing to show for it. Walked
  # exactly that way on a fresh profile.
  if service_loaded; then
    echo "note: the $LABEL service is already loaded for another profile — there is" >&2
    echo "  one per user. For a second profile run it in the foreground instead:" >&2
    echo "  BOUGH_HOME=$BOUGH_HOME BOUGH_PORT=$PORT bough run" >&2
  fi
  return 1
}

# What launchd executes (also handy for a manual foreground run). launchd starts
# with a bare environment, so put the toolchain on PATH for git/rg. The JS sidecar
# runtime is handled at the top of this file, for every subcommand rather than just
# this one.
cmd_run() {
  export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
  if [ -z "${ANTHROPIC_API_KEY:-}" ] && [ -z "${OPENROUTER_API_KEY:-}" ]; then
    # Exit 0 so launchd doesn't relaunch-loop while the machine is unconfigured.
    echo "no ANTHROPIC_API_KEY or OPENROUTER_API_KEY — put one in $ENV_FILE; not starting"
    exit 0
  fi
  cd "$ROOT"
  require_rust
  exec "$RS_BIN" start
}

cmd_start() {
  if is_up; then
    local note=""
    service_loaded || note=" (not the $SERVICE_DESC — a dev/foreground run?)"
    echo "already running (pid $(server_pid)) on http://127.0.0.1:$PORT$note"
    return 0
  fi
  if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo "error: ANTHROPIC_API_KEY is not set — put it in $ENV_FILE" >&2
    exit 1
  fi
  require_default_profile start
  svc_write
  echo "starting bough service on port $PORT (logs: $LOG_FILE)"
  svc_start
  # Said once, on the platform where it is true: a systemd user service stops at
  # logout unless the account lingers, which surprises anyone expecting the
  # LaunchAgent's always-on behaviour.
  if [ "$OS" != "Darwin" ] && have_systemd && ! loginctl show-user "$(id -un)" \
      -p Linger 2>/dev/null | grep -q 'Linger=yes'; then
    echo "note: to keep bough running after you log out:  sudo loginctl enable-linger $(id -un)"
  fi
  wait_up
}

cmd_kill() {
  if service_loaded; then
    echo "stopping service"
    svc_stop
    local i
    for i in $(seq 1 20); do
      [ -z "$(server_pid)" ] && break
      sleep 0.5
    done
  fi
  # Anything still holding the port was started outside the service (e.g. `bough run`).
  local pid
  pid="$(server_pid)"
  if [ -n "$pid" ]; then
    echo "killing non-service listener (pid $pid)"
    kill "$pid" 2>/dev/null || true
    local i
    for i in $(seq 1 20); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.5
    done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
  fi
  echo "stopped"
}

cmd_restart() {
  if service_loaded; then
    require_default_profile restart
    # REWRITTEN, not just kickstarted. `restart` used to bounce the job and leave the plist
    # exactly as it was, so a stale one — a moved repo, or a log path left behind by another
    # profile — survived every restart and could only be fixed with `kill` + `start`. That
    # is precisely how I had to repair my own install after the bug above.
    svc_write
    echo "restarting service"
    svc_restart
    wait_up
  else
    cmd_start
  fi
}

cmd_update() {
  # CHECKED BEFORE ANY GIT WORK. `update` finishes by calling `cmd_restart`, which refuses a
  # non-default profile — so without this the fast-forward, the install and the rebuild would
  # all run and only then fail, leaving the tree updated and the server stopped.
  require_default_profile update
  echo "==> fetching origin/main"
  git -C "$ROOT" fetch origin main

  local was_running=""
  is_up && was_running=1

  if ! git -C "$ROOT" merge-base --is-ancestor HEAD origin/main; then
    # Dev checkout: HEAD carries unshipped work and main's commits are shipped
    # FROM this tree — there is nothing to pull into it (a tree-level merge just
    # re-collides with its own shipped history). Leave git alone; rebuild and
    # restart from the tree as-is.
    echo "==> dev checkout (unshipped snapshot work) — skipping git update, rebuilding from the tree"
  else
    # Consumer checkout: fast-forward to the new main, carrying uncommitted
    # changes over as a patch — no `git stash` (its pop can conflict messily
    # mid-update). Untracked files pass through untouched.
    local patch added=""
    patch="$BOUGH_HOME/update-carry-$(date +%Y%m%d-%H%M%S).patch"
    git -C "$ROOT" diff --binary HEAD -- . > "$patch"
    if [ -s "$patch" ]; then
      echo "==> carrying uncommitted changes over the update ($patch)"
      # Uncommitted added files are new-file hunks in the patch and must be off
      # disk for the re-apply (git apply refuses to create over an existing file).
      added="$(git -C "$ROOT" status --porcelain | grep -E '^(A.|.A)' | cut -c4- || true)"
    else
      rm -f "$patch"
      patch=""
    fi
    git -C "$ROOT" reset -q
    git -C "$ROOT" checkout -q HEAD -- .
    if [ -n "$added" ]; then
      printf '%s\n' "$added" | while IFS= read -r f; do rm -f "$ROOT/$f"; done
    fi

    git -C "$ROOT" checkout -q main 2>/dev/null || git -C "$ROOT" checkout -qb main origin/main
    git -C "$ROOT" merge --ff-only origin/main
    echo "==> now at $(git -C "$ROOT" log -1 --format='%h %s')"

    if [ -n "$patch" ]; then
      echo "==> re-applying carried changes"
      if git -C "$ROOT" apply --3way "$patch"; then
        rm -f "$patch"
      else
        echo "error: local changes did not re-apply cleanly — patch kept at $patch" >&2
        echo "fix by hand (files may have conflict markers), then: bough restart" >&2
        exit 1
      fi
    fi
  fi

  # BUILD IT. `update` is precisely when the binary should come into existence, so
  # a machine that has never built it builds it here. A build failure is fatal:
  # the alternative is restarting the OLD binary while claiming to have updated.
  if ! command -v cargo >/dev/null; then
    echo "error: cargo not found — bough is built from source." >&2
    echo "  install Rust (https://rustup.rs), then re-run: bough update" >&2
    exit 1
  fi
  if [ -x "$RS_BIN" ]; then
    echo "==> building the server + TUI (cargo build --release)"
  else
    echo "==> first build on this machine (cargo build --release) — this may take a few minutes"
  fi
  (cd "$ROOT" && cargo build --release)

  # ast-grep: structural search (`prompt/searching.md`). Ensured on update, not just
  # on fresh setup, because the prompt names it unconditionally — an update that left
  # it out would document a tool the install does not have.
  if ! command -v ast-grep >/dev/null; then
    if [ "$OS" = "Darwin" ] && command -v brew >/dev/null; then
      echo "==> installing ast-grep (structural search) via brew"
      brew install ast-grep
    elif command -v cargo >/dev/null; then
      echo "==> installing ast-grep (structural search) via cargo"
      cargo install ast-grep --locked
    elif command -v npm >/dev/null; then
      echo "==> installing ast-grep (structural search) via npm"
      npm install -g @ast-grep/cli
    else
      echo "note: ast-grep not found and no brew/cargo/npm to install it."
      echo "  bough works without it; programs fall back to rg + view."
    fi
  fi

  # Reclaim artifacts from the retired sandbox/snapshot layers.
  migrate_reclaim

  if [ -n "$was_running" ]; then
    echo "==> restarting server"
    cmd_restart
  else
    echo "updated — start with: bough start"
  fi
}

# Set KEY=VALUE in the env file: replace the existing line (even a commented-out
# template line like "# KEY=…"), else append. Values are written verbatim.
env_set() {
  local k="$1" v="$2" cur tmp replaced=""
  cur="$(cat "$ENV_FILE" 2>/dev/null || true)"
  tmp="$(mktemp)"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "$k="* | "# $k="* | "#$k="*)
        if [ -z "$replaced" ]; then
          echo "$k=$v"
          replaced=1
        else
          echo "$line"
        fi
        ;;
      *) echo "$line" ;;
    esac
  done <<< "$cur" > "$tmp"
  [ -n "$replaced" ] || echo "$k=$v" >> "$tmp"
  tee "$ENV_FILE" < "$tmp" >/dev/null
  chmod 600 "$ENV_FILE"
  rm -f "$tmp"
}

# Reclaim on-disk artifacts from retired backends: the smolvm golden image, the
# net-era CA/policy, the AWS cred-broker LaunchAgent, and the shadow-git snapshot
# store + per-session worktrees (bough now works in the user's checkout directly).
# Idempotent — a no-op once clean. Never touches the keychain.
migrate_reclaim() {
  local freed=0 d kb
  for d in "$BOUGH_HOME/golden-rootfs" "$BOUGH_HOME/net" "$BOUGH_HOME/shadow" "$BOUGH_HOME/workspaces"; do
    [ -e "$d" ] || continue
    kb="$(du -sk "$d" 2>/dev/null | awk '{print $1}')"
    freed=$(( freed + ${kb:-0} ))
    rm -rf "$d"
  done
  rm -f "$HOME/.local/bin/smolvm"
  # The retired cred-broker was a LaunchAgent, so there is only ever one to clean
  # up on macOS. Guarded rather than left to fail quietly, so this stays readable
  # as "remove the old thing" instead of as dead code on every other OS.
  if [ "$OS" = "Darwin" ]; then
    local bplist="$HOME/Library/LaunchAgents/com.bough.credbroker.plist"
    launchctl bootout "gui/$(id -u)/com.bough.credbroker" 2>/dev/null || true
    [ -f "$bplist" ] && rm -f "$bplist"
  fi
  [ "$freed" -gt 0 ] && echo "==> reclaimed $(( freed / 1024 )) MB of retired-backend artifacts"
  return 0
}

# One command from fresh clone to running server: install deps
# (scripts/setup.sh, idempotent), then fill in the env interactively (API key)
# and start the launchd service. Safe to re-run any time — it never overwrites
# values that are already set.
cmd_setup() {
  bash "$ROOT/scripts/setup.sh"

  # setup.sh may have just created the env template — (re)load it.
  if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck source=/dev/null
    . "$ENV_FILE"
    set +a
  fi

  if [ -t 0 ]; then
    if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
      printf "ANTHROPIC_API_KEY (input hidden; empty to skip): "
      local key
      read -rs key
      echo
      if [ -n "$key" ]; then
        env_set ANTHROPIC_API_KEY "$key"
        ANTHROPIC_API_KEY="$key"
      fi
    fi
  fi

  if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo
    echo "no API key configured — put ANTHROPIC_API_KEY in $ENV_FILE, then: bough start"
    return 0
  fi
  echo
  cmd_start
}

cmd_status() {
  local svc="not installed"
  if service_loaded; then
    svc="loaded"
  elif [ "$OS" = "Darwin" ] && [ -f "$PLIST" ]; then
    svc="installed, not loaded"
  elif [ "$OS" != "Darwin" ] && [ -f "$UNIT" ]; then
    svc="installed, not loaded"
  fi
  local pid
  pid="$(server_pid)"
  if [ -z "$pid" ]; then
    echo "not running (service: $svc)"
    return 1
  fi
  if is_up; then
    echo "running (pid $pid) — http://127.0.0.1:$PORT (service: $svc)"
  else
    echo "process alive (pid $pid) but not answering on port $PORT — check $LOG_FILE"
    return 1
  fi
}

cmd_logs() {
  [ -f "$LOG_FILE" ] || { echo "no log file yet at $LOG_FILE" >&2; exit 1; }
  tail -n 50 -f "$LOG_FILE"
}

# The terminal client — what bare `bough` runs. The server is a launchd service
# that should already be up; if it isn't, start it and wait briefly.
ensure_up() {
  if ! is_up; then
    echo "server not running — starting it…" >&2
    cmd_start
    for _ in $(seq 1 20); do
      is_up && break
      sleep 0.5
    done
    if ! is_up; then
      echo "error: server didn't come up on port $PORT — check: bough logs" >&2
      exit 1
    fi
  fi
}

cmd_tui() {
  ensure_up
  # The TUI defaults new conversations to the directory bough was launched from.
  export BOUGH_TUI_CWD="$PWD"
  cd "$ROOT"
  require_rust
  exec "$RS_BIN" tui "$@"
}

# Hard-delete sessions archived over 30 days ago (the long-term purge; also runs on
# boot). Talks to the running server so it uses the same DB handle.
cmd_purge() {
  if ! is_up; then
    echo "server not running — start it first (bough start)" >&2
    exit 1
  fi
  local n
  n="$(curl -sf -m 10 -X POST "http://127.0.0.1:$PORT/purge" | sed -n 's/.*"purged":\([0-9]*\).*/\1/p')"
  echo "purged ${n:-0} session(s) archived over 30 days ago"
}

usage() {
  echo "usage: bough [tui|setup|start|kill|restart|update|status|logs|run|exec|mcp|tags|patterns|purge]"
  echo "  (no args) open the terminal UI (auto-starts the server)"
  echo "  setup    fresh clone → running: install deps, configure env, start"
  echo "  start    install + start the background service (auto-starts at login)"
  echo "  kill     stop the service and keep it stopped (across logins)"
  echo "  restart  pick up code changes explicitly"
  echo "  update   fast-forward to origin/main, rebuild, restart"
  echo "  run      run the server in the foreground (what the service executes)"
  echo "  exec     headless one-shot turn (auto-starts the server; alias: prompt):"
  echo "           bough exec [-w dir] [-m model] [--json] \"...\" — or prompt on stdin"
  echo "  sync-mcp adopt Claude Code's MCP servers into bough's registry:"
  echo "           bough sync-mcp [--from DIR] [--dry-run] [--force]"
  echo "  mcp      inspect and repair that registry (bough mcp for the full list):"
  echo "           bough mcp [list|doctor|test|auth|grant|revoke|add|remove]"
  echo "  tags     what the command memory knows, and what it primes the model with:"
  echo "           bough tags [show TAG|stats] [--repo R|--all] [--days N] [--json]"
  echo "  patterns compress a log into its distinct statements, with statistics:"
  echo "           bough patterns [--llm|--json|--human] [--top N] [FILE]"
  echo "  purge    hard-delete sessions archived over 30 days ago (also runs on boot)"
}

case "${1:-}" in
  "" | tui)
    [ $# -gt 0 ] && shift
    cmd_tui "$@"
    ;;
  help | -h | --help)
    usage
    ;;
  setup) cmd_setup ;;
  start) cmd_start ;;
  kill | stop) cmd_kill ;;
  restart) cmd_restart ;;
  update) cmd_update ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  run) cmd_run ;;
  exec | prompt)
    shift
    # Auto-start the default server like the TUI does; an explicit --port means
    # the caller manages that server (e.g. the bench), so leave it alone.
    case " $* " in *" --port "*) ;; *) ensure_up ;; esac
    require_rust
    exec "$RS_BIN" exec "$@"
    ;;
  mcp)
    shift
    # Needs a server, unlike `sync-mcp`: every verb here drives a route, because
    # connecting and authorizing are things the running process does — its manager
    # owns the connections and its OAuth callback is what the browser comes back to.
    case " $* " in *" --port "*) ;; *) ensure_up ;; esac
    require_rust
    exec "$RS_BIN" mcp "$@"
    ;;
  sync-mcp)
    shift
    # No server needed: this reads two config files and writes the registry, which
    # is a file. The server re-reads it per turn (MCP state is never cached), so a
    # running bough picks the new entries up without a restart.
    require_rust
    exec "$RS_BIN" sync-mcp "$@"
    ;;
  tags)
    shift
    # No server, like `patterns`: this reads the database and prints. Read-only by
    # discipline — every query it runs is a SELECT — so it is safe against the file a
    # running server has open, and it is exactly what you want when the question is
    # "what did I run before this broke".
    require_rust
    exec "$RS_BIN" tags "$@"
    ;;
  patterns)
    shift
    # No server, and no `ensure_up`: this reads a file (or stdin) and prints. It is
    # the one subcommand that is useful with bough stopped — which matters, because
    # "why did the server not come up" is answered by reading its log, and needing
    # the server to read the log would be a circle.
    require_rust
    exec "$RS_BIN" patterns "$@"
    ;;
  purge)
    cmd_purge
    ;;
  *)
    echo "error: unknown command '$1'" >&2
    usage >&2
    exit 1
    ;;
esac
