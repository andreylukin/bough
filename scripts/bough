#!/usr/bin/env bash
# bough server manager: setup | start | kill | restart | update | status | logs | run | net | desktop
# Runs the server as a launchd user service (starts at login, restarts on crash).
# There is no file watcher: editing code in the repo never restarts the server —
# changes only land on an explicit `bough restart` or `bough update`. Sources
# ~/.bough/env for ANTHROPIC_API_KEY / BOUGH_* settings. Installed onto PATH as
# a symlink by scripts/setup.sh.
set -euo pipefail

# Resolve the repo root through the ~/.local/bin symlink (bash 3.2 compatible).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"

BOUGH_HOME="$HOME/.bough"
LOG_FILE="$BOUGH_HOME/server.log"
ENV_FILE="$BOUGH_HOME/env"
LABEL="com.bough.server"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"

mkdir -p "$BOUGH_HOME"
if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck source=/dev/null
  . "$ENV_FILE"
  set +a
fi
PORT="${BOUGH_PORT:-4321}"

# Always exits 0: with pipefail, lsof's exit 1 on "no listener" would otherwise
# propagate through bare assignments and trip errexit.
server_pid() {
  lsof -ti "tcp:$PORT" -sTCP:LISTEN 2>/dev/null | head -n1
  return 0
}

service_loaded() {
  launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1
}

# Up = any HTTP answer on the port (200 without auth, 401 with).
is_up() {
  curl -sf -o /dev/null -m 2 "http://127.0.0.1:$PORT/sessions" ||
    [ "$(curl -s -o /dev/null -m 2 -w '%{http_code}' "http://127.0.0.1:$PORT/sessions")" = 401 ]
}

write_plist() {
  mkdir -p "$HOME/Library/LaunchAgents"
  # KeepAlive on SuccessfulExit=false: relaunch after a crash, stay down after a
  # clean exit (so a missing API key doesn't loop). No WatchPaths — on purpose.
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$ROOT/scripts/bough</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>$LOG_FILE</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict>
</plist>
EOF
}

wait_up() {
  local i
  for i in $(seq 1 30); do
    if is_up; then
      echo "up (pid $(server_pid)) — http://127.0.0.1:$PORT"
      [ -n "${BOUGH_PASSWORD:-}" ] && echo "auth: password required (LAN bind)"
      return 0
    fi
    sleep 0.5
  done
  echo "error: server did not answer on port $PORT within 15s — last log lines:" >&2
  tail -n 20 "$LOG_FILE" >&2 2>/dev/null
  return 1
}

# What launchd executes (also handy for a manual foreground run). launchd starts
# with a bare environment, so put Homebrew on PATH for deno/git/jj/llama-server.
cmd_run() {
  export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
  if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    # Exit 0 so launchd doesn't relaunch-loop while the machine is unconfigured.
    echo "ANTHROPIC_API_KEY is not set — put it in $ENV_FILE; not starting"
    exit 0
  fi
  if [ ! -f "$ROOT/web/dist/index.html" ]; then
    echo "web/dist is missing — run scripts/setup.sh (or: cd web && npm run build); not starting"
    exit 0
  fi
  cd "$ROOT"
  exec deno run --allow-net --allow-env --allow-read --allow-write \
    --allow-ffi --allow-sys --allow-run src/server/main.ts
}

cmd_start() {
  if is_up; then
    local note=""
    service_loaded || note=" (not the launchd service — a dev/foreground run?)"
    echo "already running (pid $(server_pid)) on http://127.0.0.1:$PORT$note"
    return 0
  fi
  if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo "error: ANTHROPIC_API_KEY is not set — put it in $ENV_FILE" >&2
    exit 1
  fi
  if [ ! -f "$ROOT/web/dist/index.html" ]; then
    echo "error: web/dist is missing — run scripts/setup.sh (or: cd web && npm run build)" >&2
    exit 1
  fi

  write_plist
  echo "starting bough service on port $PORT (logs: $LOG_FILE)"
  launchctl enable "$DOMAIN/$LABEL" 2>/dev/null || true
  if service_loaded; then
    launchctl kickstart "$DOMAIN/$LABEL"
  else
    launchctl bootstrap "$DOMAIN" "$PLIST"
  fi
  wait_up
}

cmd_kill() {
  if service_loaded; then
    echo "stopping service"
    # disable makes the stop stick across logins (start re-enables). bootout can
    # report non-zero while the teardown is still in flight — the wait loop below
    # is the real confirmation.
    launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    launchctl disable "$DOMAIN/$LABEL" 2>/dev/null || true
    local i
    for i in $(seq 1 20); do
      [ -z "$(server_pid)" ] && break
      sleep 0.5
    done
  fi
  # Anything still holding the port was started outside launchd (e.g. deno task dev).
  local pid
  pid="$(server_pid)"
  if [ -n "$pid" ]; then
    echo "killing non-service listener (pid $pid)"
    kill "$pid" 2>/dev/null || true
    local i
    for i in $(seq 1 20); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.5
    done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
  fi
  echo "stopped"
}

cmd_restart() {
  if service_loaded; then
    echo "restarting service"
    launchctl kickstart -k "$DOMAIN/$LABEL"
    wait_up
  else
    cmd_start
  fi
}

cmd_update() {
  echo "==> fetching origin/main"
  git -C "$ROOT" fetch origin main

  local was_running=""
  is_up && was_running=1

  if ! git -C "$ROOT" merge-base --is-ancestor HEAD origin/main; then
    # Dev checkout: HEAD sits on a jj snapshot chain carrying unshipped work,
    # and main's commits are shipped FROM this tree — there is nothing to pull
    # into it (a tree-level merge just re-collides with its own shipped
    # history). Leave git alone; rebuild and restart from the tree as-is.
    echo "==> dev checkout (unshipped snapshot work) — skipping git update, rebuilding from the tree"
  else
    # Consumer checkout: fast-forward to the new main, carrying uncommitted
    # changes over as a patch — no `git stash`, whose push/pop fails messily
    # against jj's index snapshots in a colocated repo. Lock files stay out of
    # the patch (npm install / deno install below regenerate them); untracked
    # files pass through untouched.
    local patch added=""
    patch="$BOUGH_HOME/update-carry-$(date +%Y%m%d-%H%M%S).patch"
    git -C "$ROOT" diff --binary HEAD -- . \
      ':(exclude)deno.lock' ':(exclude)web/package-lock.json' > "$patch"
    if [ -s "$patch" ]; then
      echo "==> carrying uncommitted changes over the update ($patch)"
      # Uncommitted added files are new-file hunks in the patch and must be off
      # disk for the re-apply (git apply refuses to create over an existing file).
      added="$(git -C "$ROOT" status --porcelain | grep -E '^(A.|.A)' | cut -c4- || true)"
    else
      rm -f "$patch"
      patch=""
    fi
    git -C "$ROOT" reset -q
    git -C "$ROOT" checkout -q HEAD -- .
    if [ -n "$added" ]; then
      printf '%s\n' "$added" | while IFS= read -r f; do rm -f "$ROOT/$f"; done
    fi

    git -C "$ROOT" checkout -q main 2>/dev/null || git -C "$ROOT" checkout -qb main origin/main
    git -C "$ROOT" merge --ff-only origin/main
    echo "==> now at $(git -C "$ROOT" log -1 --format='%h %s')"

    if [ -n "$patch" ]; then
      echo "==> re-applying carried changes"
      if git -C "$ROOT" apply --3way "$patch"; then
        rm -f "$patch"
      else
        echo "error: local changes did not re-apply cleanly — patch kept at $patch" >&2
        echo "fix by hand (files may have conflict markers), then: bough restart" >&2
        exit 1
      fi
    fi
  fi

  echo "==> rebuilding web UI"
  (cd "$ROOT/web" && npm install && npm run build)
  echo "==> refreshing Deno dependencies"
  (cd "$ROOT" && deno install)

  # shellcheck source=/dev/null
  . "$ROOT/scripts/worker-model.sh"
  ensure_worker_model || echo "warning: worker model download failed — re-run update to resume" >&2
  prune_stale_worker_models

  if [ -n "$was_running" ]; then
    echo "==> restarting server"
    cmd_restart
  else
    echo "updated — start with: bough start"
  fi
}

# Set KEY=VALUE in the env file: replace the existing line (even a commented-out
# template line like "# KEY=…"), else append. Values are written verbatim.
env_set() {
  local k="$1" v="$2" tmp replaced=""
  tmp="$(mktemp)"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "$k="* | "# $k="* | "#$k="*)
        if [ -z "$replaced" ]; then
          echo "$k=$v"
          replaced=1
        else
          echo "$line"
        fi
        ;;
      *) echo "$line" ;;
    esac
  done < "$ENV_FILE" > "$tmp"
  [ -n "$replaced" ] || echo "$k=$v" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

# One command from fresh clone to running server: install deps + build
# (scripts/setup.sh, idempotent), then fill in the env interactively (API key,
# Claw Patrol opt-in) and start the launchd service. Safe to re-run any time —
# it never overwrites values that are already set.
cmd_setup() {
  bash "$ROOT/scripts/setup.sh"

  # setup.sh may have just created the env template — (re)load it.
  if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck source=/dev/null
    . "$ENV_FILE"
    set +a
  fi

  if [ -t 0 ]; then
    if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
      printf "ANTHROPIC_API_KEY (input hidden; empty to skip): "
      local key
      read -rs key
      echo
      if [ -n "$key" ]; then
        env_set ANTHROPIC_API_KEY "$key"
        ANTHROPIC_API_KEY="$key"
      fi
    fi
    if ! grep -q '^BOUGH_CLAWPATROL=1' "$ENV_FILE"; then
      printf "enable Claw Patrol (egress firewall: approvals, rules, plugins)? [y/N] "
      local cp
      read -r cp
      case "$cp" in
        y | Y) env_set BOUGH_CLAWPATROL 1 && export BOUGH_CLAWPATROL=1 ;;
      esac
    fi
  fi

  if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo
    echo "no API key configured — put ANTHROPIC_API_KEY in $ENV_FILE, then: bough start"
    return 0
  fi
  echo
  cmd_start
}

cmd_status() {
  local svc="not installed"
  if service_loaded; then
    svc="loaded"
  elif [ -f "$PLIST" ]; then
    svc="installed, not loaded"
  fi
  local pid
  pid="$(server_pid)"
  if [ -z "$pid" ]; then
    echo "not running (service: $svc)"
    return 1
  fi
  if is_up; then
    echo "running (pid $pid) — http://127.0.0.1:$PORT (service: $svc)"
  else
    echo "process alive (pid $pid) but not answering on port $PORT — check $LOG_FILE"
    return 1
  fi
}

cmd_logs() {
  [ -f "$LOG_FILE" ] || { echo "no log file yet at $LOG_FILE" >&2; exit 1; }
  tail -n 50 -f "$LOG_FILE"
}

# Desktop app (deno desktop wraps the same server in a native WebKit window).
# `install` compiles into a temp dir — never the repo root, where jj's
# auto-snapshots would pick up the .app — then swaps it into /Applications.
# The entrypoint loads ~/.bough/env itself, so Finder launches work.
APP="/Applications/bough.app"

cmd_desktop() {
  case "${1:-run}" in
    run)
      cd "$ROOT"
      exec deno task desktop
      ;;
    install | restart)
      echo "==> building web UI"
      (cd "$ROOT/web" && npm run build)
      echo "==> compiling bough.app"
      local build_dir
      build_dir="$(mktemp -d)"
      (cd "$ROOT" && deno desktop --output "$build_dir/bough.app" --include web/dist \
        --allow-net --allow-env --allow-read --allow-write \
        --allow-ffi --allow-sys --allow-run src/desktop/main.ts)
      if pgrep -qf "$APP/Contents/MacOS/" 2>/dev/null; then
        echo "==> quitting running app"
        osascript -e 'tell application "bough" to quit' 2>/dev/null ||
          pkill -f "$APP/Contents/MacOS/" || true
        local i
        for i in $(seq 1 20); do
          pgrep -qf "$APP/Contents/MacOS/" 2>/dev/null || break
          sleep 0.5
        done
      fi
      rm -rf "$APP"
      mv "$build_dir/bough.app" "$APP"
      rmdir "$build_dir"
      echo "==> launching $APP"
      open "$APP"
      ;;
    *)
      echo "usage: bough desktop [run|install|restart]" >&2
      echo "  run      native window in dev mode (serves web/dist from disk)" >&2
      echo "  install  build web UI, compile bough.app, install to /Applications, launch" >&2
      echo "  restart  rebuild + reinstall + relaunch (needed to pick up any code change)" >&2
      exit 1
      ;;
  esac
}

# Claw Patrol offline checks. `net validate` runs the same load path the server
# does (policy.json + the plugin library) and reports every problem loudly.
cmd_net() {
  case "${1:-}" in
    validate)
      cd "$ROOT"
      exec deno run --allow-read --allow-write --allow-env --allow-sys src/net/validate.ts
      ;;
    *)
      echo "usage: bough net validate" >&2
      exit 1
      ;;
  esac
}

case "${1:-}" in
  setup) cmd_setup ;;
  start) cmd_start ;;
  kill | stop) cmd_kill ;;
  restart) cmd_restart ;;
  update) cmd_update ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  run) cmd_run ;;
  net)
    shift
    cmd_net "$@"
    ;;
  desktop)
    shift
    cmd_desktop "$@"
    ;;
  *)
    echo "usage: bough {setup|start|kill|restart|update|status|logs|run|net|desktop}" >&2
    echo "  setup    fresh clone → running: install deps, build, configure env, start" >&2
    echo "  start    install + start the launchd service (auto-starts at login)" >&2
    echo "  kill     stop the service and keep it stopped (across logins)" >&2
    echo "  restart  pick up code changes explicitly" >&2
    echo "  update   fast-forward to origin/main, rebuild, restart" >&2
    echo "  run      run the server in the foreground (what launchd executes)" >&2
    echo "  net      Claw Patrol checks: 'bough net validate' verifies policy + plugins" >&2
    echo "  desktop  native app: 'bough desktop [run|install|restart]'" >&2
    exit 1
    ;;
esac
