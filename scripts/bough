#!/usr/bin/env bash
# bough server manager: setup | start | kill | restart | update | status | logs | run | net
# Runs the server as a launchd user service (starts at login, restarts on crash).
# There is no file watcher: editing code in the repo never restarts the server —
# changes only land on an explicit `bough restart` or `bough update`. Sources
# ~/.bough/env for ANTHROPIC_API_KEY / BOUGH_* settings. Installed onto PATH as
# a symlink by scripts/setup.sh.
set -euo pipefail

# Resolve the repo root through the ~/.local/bin symlink (bash 3.2 compatible).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"

LABEL="com.bough.server"

# Agent-user mode: the server runs as a dedicated non-admin user via a system
# LaunchDaemon; you drive it from the bough TUI and manage it through sudo. The
# flag lives in YOUR ~/.bough/env (read before we know the agent's home), so we
# peek at it directly. Legacy single-user LaunchAgent stays the default.
CALLER_ENV="$HOME/.bough/env"
AGENT_USER=""
if [ -f "$CALLER_ENV" ]; then
  AGENT_USER="$(grep -E '^BOUGH_AGENT_USER=' "$CALLER_ENV" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
fi

if [ -n "$AGENT_USER" ]; then
  AGENT_HOME="$(dscl . -read "/Users/$AGENT_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
  [ -n "$AGENT_HOME" ] || { echo "error: agent user '$AGENT_USER' not found — run scripts/agent-user.sh" >&2; exit 1; }
  BOUGH_HOME="$AGENT_HOME/.bough"
  PLIST="/Library/LaunchDaemons/$LABEL.plist"
  DOMAIN="system"
  # launchctl for the system domain needs root; grant/logs run as the agent.
  LAUNCHCTL="sudo launchctl"
  AS_AGENT=(sudo -u "$AGENT_USER")
else
  AGENT_HOME="$HOME"
  BOUGH_HOME="$HOME/.bough"
  PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
  DOMAIN="gui/$(id -u)"
  LAUNCHCTL="launchctl"
  # `env` as a no-op prefix: bash 3.2 + `set -u` treats expanding an empty
  # array as an unbound variable, so AS_AGENT can never be ().
  AS_AGENT=(env)
fi

LOG_FILE="$BOUGH_HOME/server.log"
ENV_FILE="$BOUGH_HOME/env"

mkdir -p "$HOME/.bough"
if [ -f "$ENV_FILE" ] && [ -r "$ENV_FILE" ]; then
  set -a
  # shellcheck source=/dev/null
  . "$ENV_FILE"
  set +a
fi
PORT="${BOUGH_PORT:-4321}"

# Always exits 0: with pipefail, lsof's exit 1 on "no listener" would otherwise
# propagate through bare assignments and trip errexit.
server_pid() {
  # As the agent user (its own socket) in agent mode, else directly — a plain
  # caller's lsof can't see another user's listening socket.
  "${AS_AGENT[@]}" lsof -ti "tcp:$PORT" -sTCP:LISTEN 2>/dev/null | head -n1
  return 0
}

service_loaded() {
  $LAUNCHCTL print "$DOMAIN/$LABEL" >/dev/null 2>&1
}

# Up = any HTTP answer on the port (200 without auth, 401 with).
is_up() {
  curl -sf -o /dev/null -m 2 "http://127.0.0.1:$PORT/sessions" ||
    [ "$(curl -s -o /dev/null -m 2 -w '%{http_code}' "http://127.0.0.1:$PORT/sessions")" = 401 ]
}

# In agent-user mode the plist is a system LaunchDaemon (owned root:wheel, with a
# UserName key) written via sudo; otherwise a per-user LaunchAgent. KeepAlive on
# SuccessfulExit=false: relaunch after a crash, stay down after a clean exit (so
# a missing API key doesn't loop). No WatchPaths — on purpose.
write_plist() {
  local user_key=""
  local writer=(tee)
  if [ -n "$AGENT_USER" ]; then
    user_key="  <key>UserName</key><string>$AGENT_USER</string>"
    writer=(sudo tee)
  else
    mkdir -p "$HOME/Library/LaunchAgents"
  fi
  "${writer[@]}" "$PLIST" >/dev/null <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
$user_key
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$ROOT/scripts/bough</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>$LOG_FILE</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict>
</plist>
EOF
  [ -n "$AGENT_USER" ] && sudo chown root:wheel "$PLIST"
  return 0
}

wait_up() {
  local i
  for i in $(seq 1 30); do
    if is_up; then
      echo "up (pid $(server_pid)) — http://127.0.0.1:$PORT"
      [ -n "${BOUGH_PASSWORD:-}" ] && echo "auth: password required (LAN bind)"
      return 0
    fi
    sleep 0.5
  done
  echo "error: server did not answer on port $PORT within 15s — last log lines:" >&2
  tail -n 20 "$LOG_FILE" >&2 2>/dev/null
  return 1
}

# What launchd executes (also handy for a manual foreground run). launchd starts
# with a bare environment, so put Homebrew on PATH for deno/git/llama-server.
cmd_run() {
  export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
  if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    # Exit 0 so launchd doesn't relaunch-loop while the machine is unconfigured.
    echo "ANTHROPIC_API_KEY is not set — put it in $ENV_FILE; not starting"
    exit 0
  fi
  cd "$ROOT"
  exec deno run --allow-net --allow-env --allow-read --allow-write \
    --allow-ffi --allow-sys --allow-run src/server/main.ts
}

cmd_start() {
  if is_up; then
    local note=""
    service_loaded || note=" (not the launchd service — a dev/foreground run?)"
    echo "already running (pid $(server_pid)) on http://127.0.0.1:$PORT$note"
    return 0
  fi
  # In agent-user mode the key lives in the agent's 0600 env, which this account
  # can't read — the daemon's own `run` does the check and exits cleanly if unset.
  if [ -z "$AGENT_USER" ] && [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo "error: ANTHROPIC_API_KEY is not set — put it in $ENV_FILE" >&2
    exit 1
  fi
  write_plist
  echo "starting bough service on port $PORT (logs: $LOG_FILE)"
  $LAUNCHCTL enable "$DOMAIN/$LABEL" 2>/dev/null || true
  if service_loaded; then
    $LAUNCHCTL kickstart "$DOMAIN/$LABEL"
  else
    $LAUNCHCTL bootstrap "$DOMAIN" "$PLIST"
  fi
  wait_up
}

cmd_kill() {
  if service_loaded; then
    echo "stopping service"
    # disable makes the stop stick across logins (start re-enables). bootout can
    # report non-zero while the teardown is still in flight — the wait loop below
    # is the real confirmation.
    $LAUNCHCTL bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    $LAUNCHCTL disable "$DOMAIN/$LABEL" 2>/dev/null || true
    local i
    for i in $(seq 1 20); do
      [ -z "$(server_pid)" ] && break
      sleep 0.5
    done
  fi
  # Anything still holding the port was started outside launchd (e.g. deno task dev).
  local pid
  pid="$(server_pid)"
  if [ -n "$pid" ]; then
    echo "killing non-service listener (pid $pid)"
    "${AS_AGENT[@]}" kill "$pid" 2>/dev/null || true
    local i
    for i in $(seq 1 20); do
      "${AS_AGENT[@]}" kill -0 "$pid" 2>/dev/null || break
      sleep 0.5
    done
    "${AS_AGENT[@]}" kill -0 "$pid" 2>/dev/null && "${AS_AGENT[@]}" kill -9 "$pid" 2>/dev/null
  fi
  echo "stopped"
}

cmd_restart() {
  if service_loaded; then
    echo "restarting service"
    $LAUNCHCTL kickstart -k "$DOMAIN/$LABEL"
    wait_up
  else
    cmd_start
  fi
}

cmd_update() {
  echo "==> fetching origin/main"
  git -C "$ROOT" fetch origin main

  local was_running=""
  is_up && was_running=1

  if ! git -C "$ROOT" merge-base --is-ancestor HEAD origin/main; then
    # Dev checkout: HEAD carries unshipped work and main's commits are shipped
    # FROM this tree — there is nothing to pull into it (a tree-level merge just
    # re-collides with its own shipped history). Leave git alone; rebuild and
    # restart from the tree as-is.
    echo "==> dev checkout (unshipped snapshot work) — skipping git update, rebuilding from the tree"
  else
    # Consumer checkout: fast-forward to the new main, carrying uncommitted
    # changes over as a patch — no `git stash` (its pop can conflict messily
    # mid-update). Lock files stay out of the patch (npm install / deno install
    # below regenerate them); untracked files pass through untouched.
    local patch added=""
    patch="$BOUGH_HOME/update-carry-$(date +%Y%m%d-%H%M%S).patch"
    git -C "$ROOT" diff --binary HEAD -- . \
      ':(exclude)deno.lock' > "$patch"
    if [ -s "$patch" ]; then
      echo "==> carrying uncommitted changes over the update ($patch)"
      # Uncommitted added files are new-file hunks in the patch and must be off
      # disk for the re-apply (git apply refuses to create over an existing file).
      added="$(git -C "$ROOT" status --porcelain | grep -E '^(A.|.A)' | cut -c4- || true)"
    else
      rm -f "$patch"
      patch=""
    fi
    git -C "$ROOT" reset -q
    git -C "$ROOT" checkout -q HEAD -- .
    if [ -n "$added" ]; then
      printf '%s\n' "$added" | while IFS= read -r f; do rm -f "$ROOT/$f"; done
    fi

    git -C "$ROOT" checkout -q main 2>/dev/null || git -C "$ROOT" checkout -qb main origin/main
    git -C "$ROOT" merge --ff-only origin/main
    echo "==> now at $(git -C "$ROOT" log -1 --format='%h %s')"

    if [ -n "$patch" ]; then
      echo "==> re-applying carried changes"
      if git -C "$ROOT" apply --3way "$patch"; then
        rm -f "$patch"
      else
        echo "error: local changes did not re-apply cleanly — patch kept at $patch" >&2
        echo "fix by hand (files may have conflict markers), then: bough restart" >&2
        exit 1
      fi
    fi
  fi

  echo "==> refreshing Deno dependencies"
  (cd "$ROOT" && deno install)

  # leta + tsserver: LSP backend (lsp.* host functions). Added in the leta
  # cutover — ensure they exist on update, not just fresh setup.
  if ! command -v leta >/dev/null; then
    echo "==> installing leta (LSP backend) via brew tap"
    brew install andreasjansson/tap/leta
  fi
  if ! command -v typescript-language-server >/dev/null; then
    echo "==> installing typescript-language-server + typescript@5 (npm global)"
    npm install -g typescript-language-server typescript@5
  fi

  # shellcheck source=/dev/null
  . "$ROOT/scripts/worker-model.sh"
  if [ -n "${BOUGH_WORKER_FRONTIER:-}" ] && [ "${BOUGH_WORKER_FRONTIER}" != "0" ]; then
    echo "==> BOUGH_WORKER_FRONTIER is set — skipping local worker model download"
  else
    ensure_worker_model || echo "warning: worker model download failed — re-run update to resume" >&2
  fi
  prune_stale_worker_models

  if [ -n "$was_running" ]; then
    echo "==> restarting server"
    cmd_restart
  else
    echo "updated — start with: bough start"
  fi
}

# Set KEY=VALUE in the env file: replace the existing line (even a commented-out
# template line like "# KEY=…"), else append. Values are written verbatim. Reads
# and writes through the agent user in agent-user mode (the env is 0600, its own).
env_set() {
  local k="$1" v="$2" cur tmp replaced=""
  cur="$("${AS_AGENT[@]}" cat "$ENV_FILE" 2>/dev/null || true)"
  tmp="$(mktemp)"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "$k="* | "# $k="* | "#$k="*)
        if [ -z "$replaced" ]; then
          echo "$k=$v"
          replaced=1
        else
          echo "$line"
        fi
        ;;
      *) echo "$line" ;;
    esac
  done <<< "$cur" > "$tmp"
  [ -n "$replaced" ] || echo "$k=$v" >> "$tmp"
  "${AS_AGENT[@]}" tee "$ENV_FILE" < "$tmp" >/dev/null
  "${AS_AGENT[@]}" chmod 600 "$ENV_FILE"
  rm -f "$tmp"
}

# One command from fresh clone to running server: install deps
# (scripts/setup.sh, idempotent), then fill in the env interactively (API key,
# Claw Patrol opt-in) and start the launchd service. Safe to re-run any time —
# it never overwrites values that are already set.
cmd_setup() {
  bash "$ROOT/scripts/setup.sh"

  # setup.sh may have just created the env template — (re)load it.
  if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck source=/dev/null
    . "$ENV_FILE"
    set +a
  fi

  if [ -t 0 ]; then
    if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
      printf "ANTHROPIC_API_KEY (input hidden; empty to skip): "
      local key
      read -rs key
      echo
      if [ -n "$key" ]; then
        env_set ANTHROPIC_API_KEY "$key"
        ANTHROPIC_API_KEY="$key"
      fi
    fi
    # Claw Patrol is on by default now; offer to opt out (writes =0).
    if [ "${BOUGH_CLAWPATROL:-}" != "0" ]; then
      printf "Claw Patrol (egress firewall: approvals, rules, plugins) is ON. Disable it? [y/N] "
      local cp
      read -r cp
      case "$cp" in
        y | Y) env_set BOUGH_CLAWPATROL 0 && export BOUGH_CLAWPATROL=0 ;;
      esac
    fi
  fi

  if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo
    echo "no API key configured — put ANTHROPIC_API_KEY in $ENV_FILE, then: bough start"
    return 0
  fi
  echo
  cmd_start
}

cmd_status() {
  local svc="not installed"
  if service_loaded; then
    svc="loaded"
  elif [ -f "$PLIST" ]; then
    svc="installed, not loaded"
  fi
  local pid
  pid="$(server_pid)"
  if [ -z "$pid" ]; then
    echo "not running (service: $svc)"
    return 1
  fi
  if is_up; then
    echo "running (pid $pid) — http://127.0.0.1:$PORT (service: $svc)"
  else
    echo "process alive (pid $pid) but not answering on port $PORT — check $LOG_FILE"
    return 1
  fi
}

cmd_logs() {
  [ -f "$LOG_FILE" ] || { echo "no log file yet at $LOG_FILE" >&2; exit 1; }
  tail -n 50 -f "$LOG_FILE"
}


GROUP="bough-work"
GRANTS_JSON="$BOUGH_HOME/grants.json"

# Full inherited rwx for the shared group on a granted repo, so the agent-user
# server can read/edit/snapshot it while your account keeps ownership.
ACL_DIR='group:bough-work allow read,write,delete,add_file,add_subdirectory,readattr,writeattr,readextattr,writeextattr,readsecurity,list,search,file_inherit,directory_inherit'
# Traverse-only on the parent chain, so the agent can reach the repo without
# being able to list your other directories.
ACL_TRAVERSE='group:bough-work allow execute,readattr,readextattr,readsecurity'

require_agent_mode() {
  [ -n "$AGENT_USER" ] && return 0
  echo "error: '$1' requires agent-user mode (set BOUGH_AGENT_USER in $CALLER_ENV" >&2
  echo "       and run scripts/agent-user.sh first)" >&2
  exit 1
}

# JSON array read/modify/write as the agent (grants.json is agent-owned, 0600).
grants_edit() { # $1 = add|remove, $2 = abs path
  local deno; deno="$(command -v deno)"
  "${AS_AGENT[@]}" env OP="$1" P="$2" F="$GRANTS_JSON" "$deno" eval '
    const f = Deno.env.get("F"), op = Deno.env.get("OP"), p = Deno.env.get("P");
    let a = []; try { a = JSON.parse(Deno.readTextFileSync(f)); } catch {}
    a = a.filter((x) => x !== p);
    if (op === "add") a.push(p);
    Deno.mkdirSync(f.replace(/\/[^/]*$/, ""), { recursive: true });
    Deno.writeTextFileSync(f, JSON.stringify(a, null, 2) + "\n");
  '
}

cmd_grant() {
  require_agent_mode grant
  local dir="${1:-}"
  [ -n "$dir" ] || { echo "usage: bough grant <dir>" >&2; exit 1; }
  dir="$(cd "$dir" 2>/dev/null && pwd)" || { echo "error: no such directory: $1" >&2; exit 1; }
  echo "==> granting $GROUP access to $dir"
  chmod +a "$ACL_DIR" "$dir"
  # Traverse ACL on each parent up to (not including) /Users, so the agent can
  # walk into the repo. Idempotent: chmod +a is a no-op if the ACE exists.
  local p="$dir"
  while [ "$p" != "/" ] && [ "$p" != "/Users" ]; do
    p="$(dirname "$p")"
    [ "$p" = "/" ] || [ "$p" = "/Users" ] && break
    chmod +a "$ACL_TRAVERSE" "$p" 2>/dev/null || true
  done
  # git runs as the agent across a uid boundary — mark the repo safe for it.
  "${AS_AGENT[@]}" git config --global --add safe.directory "$dir" 2>/dev/null || true
  grants_edit add "$dir"
  echo "granted. New sessions can now use $dir."
}

cmd_revoke() {
  require_agent_mode revoke
  local dir="${1:-}"
  [ -n "$dir" ] || { echo "usage: bough revoke <dir>" >&2; exit 1; }
  dir="$(cd "$dir" 2>/dev/null && pwd)" || dir="$1"
  echo "==> revoking $GROUP access to $dir"
  chmod -a "$ACL_DIR" "$dir" 2>/dev/null || true
  "${AS_AGENT[@]}" git config --global --unset-all safe.directory "$dir" 2>/dev/null || true
  grants_edit remove "$dir"
  # Parent traverse ACLs are intentionally left in place: other granted repos may
  # share the same parent chain. They leak nothing (execute-only, no list).
  echo "revoked."
}

# Reverse the cutover: stop + remove the daemon, drop grants, and print the
# remaining root-owned bits for you to remove by hand.
cmd_teardown() {
  require_agent_mode teardown
  echo "==> stopping and removing the LaunchDaemon"
  sudo launchctl bootout "system/$LABEL" 2>/dev/null || true
  sudo rm -f "$PLIST"
  if [ -f "$GRANTS_JSON" ] && [ -r "$GRANTS_JSON" ]; then
    echo "==> revoking recorded grants"
    "${AS_AGENT[@]}" cat "$GRANTS_JSON" 2>/dev/null |
      "$(command -v deno)" eval 'for (const p of JSON.parse(await new Response(Deno.stdin.readable).text())) console.log(p)' 2>/dev/null |
      while IFS= read -r d; do [ -n "$d" ] && chmod -a "$ACL_DIR" "$d" 2>/dev/null || true; done
  fi
  echo
  echo "removed the daemon and repo ACLs. To finish teardown by hand:"
  echo "  sudo rm -f /etc/sudoers.d/bough-agent-user /etc/sudoers.d/bough-agent"
  echo "  sudo sysadminctl -deleteUser $AGENT_USER   # also removes ~$AGENT_USER"
  echo "  # then remove BOUGH_AGENT_USER from $CALLER_ENV and: bough start"
}

# Migrate this account's ~/.bough state into the agent user's home and install
# the system LaunchDaemon. Idempotent; never overwrites values already present.
cmd_setup_agent_user() {
  require_agent_mode "setup --agent-user"
  local src="$HOME/.bough" dst="$AGENT_HOME/.bough"
  echo "==> migrating state $src -> $dst (as $AGENT_USER)"
  sudo mkdir -p "$dst"
  # Copy env (minus the caller-only flag), net policy + CA, and the worker model.
  if [ -f "$src/env" ]; then
    grep -v '^BOUGH_AGENT_USER=' "$src/env" | "${AS_AGENT[@]}" tee "$dst/env" >/dev/null
    "${AS_AGENT[@]}" chmod 600 "$dst/env"
  fi
  for sub in net models; do
    [ -d "$src/$sub" ] && sudo cp -R "$src/$sub" "$dst/" && sudo chown -R "$AGENT_USER" "$dst/$sub"
  done
  sudo chown -R "$AGENT_USER" "$dst"
  # kubeconfig: the host-side source setupKube reads to mint + rewrite. The sandbox
  # copy is auth-stripped by rewriteKubeconfig; impersonation demotes at the proxy.
  if [ -f "$HOME/.kube/config" ]; then
    echo "==> copying kubeconfig to $AGENT_HOME/.kube/config"
    sudo mkdir -p "$AGENT_HOME/.kube"
    sudo cp "$HOME/.kube/config" "$AGENT_HOME/.kube/config"
    sudo chown -R "$AGENT_USER" "$AGENT_HOME/.kube"
    sudo chmod 600 "$AGENT_HOME/.kube/config"
  fi
  # Group-readable log so `bough logs` works from your account.
  "${AS_AGENT[@]}" touch "$dst/server.log"
  "${AS_AGENT[@]}" chmod 640 "$dst/server.log"
  sudo chgrp "$GROUP" "$dst" "$dst/server.log" 2>/dev/null || true
  # Rewrite SSH GitHub remotes to HTTPS so git always traverses the proxy (SSH would
  # bypass the gate entirely). The read-only PAT is injected on the wire by the proxy.
  "${AS_AGENT[@]}" git config --global url."https://github.com/".insteadOf "git@github.com:" 2>/dev/null || true
  echo "==> installing the system LaunchDaemon"
  write_plist
  echo
  echo "migrated. Next:"
  echo "  1. bough grant <dir>       # per-repo access for the agent"
  echo "  2. bough start"
  echo "  3. trust the MITM CA for Go tools (gh): the exact 'security add-trusted-cert'"
  echo "     command is shown in the Network rail (and 'bough status' via the API) once"
  echo "     the server is up — run it once with sudo."
}

BROKER_LABEL="com.bough.credbroker"
BROKER_PLIST="$HOME/Library/LaunchAgents/$BROKER_LABEL.plist"
BROKER_PORT="${BOUGH_AWS_BROKER_PORT:-9109}"
# Shared, world-traversable path so the agent user (a bough-work member) can read
# the boot-fresh, 0640 group-owned bearer written by the caller-run broker.
BROKER_TOKEN_FILE="/Users/Shared/.bough-broker-token"

# Pick the profile the broker vends to the agent: --profile wins, else bough-ro
# if configured, else default. `aws configure export-credentials` resolves ANY
# auth shape behind it (SSO, static keys, assume-role, credential_process), so
# the profile name is the only thing setup ever needs to know.
broker_pick_profile() {
  local want="$1" profiles
  profiles="$(aws configure list-profiles 2>/dev/null || true)"
  if [ -n "$want" ]; then
    echo "$profiles" | grep -qx "$want" || {
      echo "profile '$want' not found in ~/.aws — available:" >&2
      echo "$profiles" | sed 's/^/  /' >&2
      return 1
    }
    echo "$want"
    return
  fi
  if echo "$profiles" | grep -qx "bough-ro"; then echo "bough-ro"; return; fi
  if echo "$profiles" | grep -qx "default"; then echo "default"; return; fi
  echo "no AWS profiles configured — run 'aws configure' or 'aws configure sso' first" >&2
  return 1
}

# The AWS credential broker (Phase 2). Always runs in YOUR account — it needs the
# interactive SSO cache — even when the server runs as the agent user. Installs a
# per-user LaunchAgent and points the server env at it.
cmd_broker() {
  local deno; deno="$(command -v deno)"
  case "${1:-}" in
    install)
      command -v aws >/dev/null || {
        echo "aws CLI not found — install it first (brew install awscli)" >&2
        exit 1
      }
      local profile_arg=""
      case "${2:-}" in
        --profile) profile_arg="${3:-}" ;;
        --profile=*) profile_arg="${2#--profile=}" ;;
        "") ;;
        *) echo "usage: bough broker install [--profile NAME]" >&2; exit 1 ;;
      esac
      local profile
      profile="$(broker_pick_profile "$profile_arg")" || exit 1
      # Prove the profile resolves at least once (an expired SSO session is fine —
      # the broker heals after `aws sso login`; anything else is a config error).
      local preflight
      if ! preflight="$(aws configure export-credentials --profile "$profile" --format process 2>&1 >/dev/null)"; then
        case "$(echo "$preflight" | tr '[:upper:]' '[:lower:]')" in
          *sso* | *expired*)
            echo "note: SSO session expired — broker will work after: aws sso login --profile $profile" ;;
          *)
            echo "profile '$profile' can't mint credentials:" >&2
            echo "$preflight" | tail -3 | sed 's/^/  /' >&2
            exit 1 ;;
        esac
      fi
      [ "$profile" = "bough-ro" ] ||
        echo "WARNING: agent sessions get the FULL permissions of profile '$profile' — consider a read-only role (bough-ro)"
      echo "==> installing $BROKER_LABEL (runs as $(id -un), port $BROKER_PORT, profile $profile)"
      mkdir -p "$HOME/Library/LaunchAgents"
      cat > "$BROKER_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$BROKER_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$deno</string><string>run</string>
    <string>--allow-net</string><string>--allow-env</string>
    <string>--allow-read</string><string>--allow-write</string><string>--allow-run</string>
    <string>$ROOT/scripts/cred-broker.ts</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>$HOME</string>
    <key>BOUGH_AWS_BROKER_PORT</key><string>$BROKER_PORT</string>
    <key>BOUGH_AWS_BROKER_TOKEN_FILE</key><string>$BROKER_TOKEN_FILE</string>
    <key>BOUGH_AWS_RO_PROFILE</key><string>$profile</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$HOME/.bough/broker.log</string>
  <key>StandardErrorPath</key><string>$HOME/.bough/broker.log</string>
</dict>
</plist>
EOF
      launchctl bootout "gui/$(id -u)/$BROKER_LABEL" 2>/dev/null || true
      launchctl bootstrap "gui/$(id -u)" "$BROKER_PLIST"
      # Point the server (agent env in agent-user mode) at the broker.
      env_set BOUGH_AWS_BROKER_URL "http://127.0.0.1:$BROKER_PORT/aws"
      env_set BOUGH_AWS_BROKER_TOKEN_FILE "$BROKER_TOKEN_FILE"
      # Verify end to end: poll until the agent answers, then test-mint once.
      local i code=""
      for i in $(seq 1 20); do
        code="$(curl -s -o /dev/null -m 2 -w '%{http_code}' \
          -H "authorization: Bearer $(cat "$BROKER_TOKEN_FILE" 2>/dev/null)" \
          "http://127.0.0.1:$BROKER_PORT/aws" 2>/dev/null || true)"
        [ "$code" = 200 ] || [ "$code" = 503 ] && break
        sleep 0.5
      done
      case "$code" in
        200) echo "verified: broker minting credentials for profile '$profile'" ;;
        503) echo "broker up; credentials pending login: aws sso login --profile $profile" ;;
        *) echo "WARNING: broker not answering (HTTP ${code:-none}) — check $HOME/.bough/broker.log" ;;
      esac
      echo "done. Restart the server to inject creds into sessions: bough restart"
      ;;
    uninstall)
      launchctl bootout "gui/$(id -u)/$BROKER_LABEL" 2>/dev/null || true
      rm -f "$BROKER_PLIST"
      echo "broker removed. Remove BOUGH_AWS_BROKER_* from $ENV_FILE to fully disable."
      ;;
    status)
      if launchctl print "gui/$(id -u)/$BROKER_LABEL" >/dev/null 2>&1; then
        curl -s -o /dev/null -w "broker: loaded, HTTP %{http_code} on :$BROKER_PORT\n" \
          -H "authorization: Bearer $(cat "$BROKER_TOKEN_FILE" 2>/dev/null)" \
          "http://127.0.0.1:$BROKER_PORT/aws" || echo "broker: loaded, not answering"
      else
        echo "broker: not installed"
      fi
      ;;
    *)
      echo "usage: bough broker {install|uninstall|status}" >&2
      exit 1
      ;;
  esac
}

# Claw Patrol offline checks. `net validate` runs the same load path the server
# does (policy.json + the plugin library) and reports every problem loudly.
cmd_net() {
  case "${1:-}" in
    validate)
      cd "$ROOT"
      exec deno run --allow-read --allow-write --allow-env --allow-sys src/net/validate.ts
      ;;
    *)
      echo "usage: bough net validate" >&2
      exit 1
      ;;
  esac
}

# The terminal client — what bare `bough` runs. The server is a launchd service
# that should already be up; if it isn't, start it and wait briefly.
ensure_up() {
  if ! is_up; then
    echo "server not running — starting it…" >&2
    cmd_start
    for _ in $(seq 1 20); do
      is_up && break
      sleep 0.5
    done
    if ! is_up; then
      echo "error: server didn't come up on port $PORT — check: bough logs" >&2
      exit 1
    fi
  fi
}

cmd_tui() {
  ensure_up
  # The TUI defaults new conversations to the directory bough was launched from.
  export BOUGH_TUI_CWD="$PWD"
  cd "$ROOT"
  # --no-prompt: Deno's node:tty requests an optional write permission on startup;
  # denied it works fine, but the interactive prompt would eat the first keystrokes.
  exec deno run --no-prompt --allow-net=127.0.0.1 --allow-env --allow-read \
    --allow-write=/dev/tty,"$HOME/.bough" --allow-sys --allow-run src/tui/main.tsx "$@"
}

# Hard-delete sessions archived over 30 days ago (the long-term purge; also runs on
# boot). Talks to the running server so it uses the same DB handle.
cmd_purge() {
  if ! is_up; then
    echo "server not running — start it first (bough start)" >&2
    exit 1
  fi
  local n
  n="$(curl -sf -m 10 -X POST "http://127.0.0.1:$PORT/purge" | sed -n 's/.*"purged":\([0-9]*\).*/\1/p')"
  echo "purged ${n:-0} session(s) archived over 30 days ago"
}

usage() {
  echo "usage: bough [tui|setup|grant|revoke|teardown|start|kill|restart|update|status|logs|run|exec|broker|net|purge]"
  echo "  (no args) open the terminal UI (auto-starts the server)"
  echo "  setup    fresh clone → running: install deps, configure env, start"
  echo "           setup --agent-user: migrate state + install the dedicated-user daemon"
  echo "  grant    bough grant <dir>: give the agent user access to a project dir"
  echo "  revoke   bough revoke <dir>: remove the agent user's access"
  echo "  teardown teardown --agent-user: reverse the dedicated-user cutover"
  echo "  start    install + start the launchd service (auto-starts at login)"
  echo "  kill     stop the service and keep it stopped (across logins)"
  echo "  restart  pick up code changes explicitly"
  echo "  update   fast-forward to origin/main, rebuild, restart"
  echo "  run      run the server in the foreground (what launchd executes)"
  echo "  exec     headless one-shot turn (auto-starts the server; alias: prompt):"
  echo "           bough exec [-w dir] [-m model] [--yolo] [--json] \"...\" — or prompt on stdin"
  echo "  broker   AWS credential broker: 'bough broker {install [--profile NAME]|uninstall|status}'"
  echo "  net      Claw Patrol checks: 'bough net validate' verifies policy + plugins"
  echo "  purge    hard-delete sessions archived over 30 days ago (also runs on boot)"
}

case "${1:-}" in
  "" | tui)
    [ $# -gt 0 ] && shift
    cmd_tui "$@"
    ;;
  help | -h | --help)
    usage
    ;;
  setup)
    if [ "${2:-}" = "--agent-user" ]; then cmd_setup_agent_user; else cmd_setup; fi
    ;;
  grant) cmd_grant "${2:-}" ;;
  revoke) cmd_revoke "${2:-}" ;;
  teardown)
    [ "${2:-}" = "--agent-user" ] || { echo "usage: bough teardown --agent-user" >&2; exit 1; }
    cmd_teardown
    ;;
  start) cmd_start ;;
  kill | stop) cmd_kill ;;
  restart) cmd_restart ;;
  update) cmd_update ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  run) cmd_run ;;
  exec | prompt)
    shift
    # Auto-start the default server like the TUI does; an explicit --port means
    # the caller manages that server (e.g. the bench), so leave it alone.
    case " $* " in *" --port "*) ;; *) ensure_up ;; esac
    exec deno run --no-prompt --allow-net=127.0.0.1 --allow-env --allow-read \
      "$ROOT/src/cli/exec.ts" "$@"
    ;;
  broker)
    shift
    cmd_broker "$@"
    ;;
  net)
    shift
    cmd_net "$@"
    ;;
  purge)
    cmd_purge
    ;;
  *)
    echo "error: unknown command '$1'" >&2
    usage >&2
    exit 1
    ;;
esac
