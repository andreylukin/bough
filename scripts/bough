#!/usr/bin/env bash
# bough launcher.
#   bough          start the server, wait for health, then open the web UI
#                  in your browser (the server runs in the foreground; Ctrl-C
#                  stops it)
#   bough restart  stop any server already listening on the port, then start a
#                  fresh one (and open the web UI), same as a plain `bough`
#   bough update   pull the latest version from git, rebuild, and reconcile the
#                  worker model (fetch the current GGUF, drop superseded ones)

set -euo pipefail

# Resolve symlinks so `bough` works when invoked via a link on PATH.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE#/}" = "$SOURCE" ] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
SERVER="${BOUGH_SERVER:-http://127.0.0.1:4096}"
# The TCP port the server listens on, parsed from SERVER (host:port[/path]).
PORT="${SERVER##*:}"; PORT="${PORT%%/*}"

# Stop whatever bough server is currently listening on $PORT (the BEAM node a
# `bough`/`bough restart` started). No-op if nothing is up. Used by `restart`.
stop_server() {
  command -v lsof >/dev/null 2>&1 || { echo "error: lsof not found — can't locate the running server." >&2; return 1; }
  local pids
  pids="$(lsof -ti "tcp:$PORT" -sTCP:LISTEN 2>/dev/null || true)"
  if [ -z "$pids" ]; then echo "no bough server listening on :$PORT."; return 0; fi
  echo "stopping bough server on :$PORT (pid: $(echo "$pids" | tr '\n' ' '))..."
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true
  # Wait for the port to free, escalating to SIGKILL if it lingers.
  for _ in $(seq 1 20); do
    lsof -ti "tcp:$PORT" -sTCP:LISTEN >/dev/null 2>&1 || return 0
    sleep 0.5
  done
  pids="$(lsof -ti "tcp:$PORT" -sTCP:LISTEN 2>/dev/null || true)"
  # shellcheck disable=SC2086
  [ -n "$pids" ] && { echo "server still up — forcing..."; kill -9 $pids 2>/dev/null || true; }
  return 0
}

# Subcommands.
case "${1:-}" in
  update)
    echo "updating bough in $ROOT"
    branch="$(git -C "$ROOT" symbolic-ref --quiet --short HEAD || echo HEAD)"
    if ! git -C "$ROOT" pull --ff-only; then
      echo "error: could not fast-forward $branch — resolve changes in $ROOT and retry." >&2
      exit 1
    fi
    make -C "$ROOT" build
    # Reconcile the worker model: drop any superseded GGUF (e.g. machines that
    # installed the old VibeThinker file) and fetch the current one if missing,
    # so the engine's default_gguf is actually on disk. BOUGH_NO_MODEL=1 skips.
    # shellcheck source=scripts/worker-model.sh
    . "$ROOT/scripts/worker-model.sh"
    if [ "${BOUGH_NO_MODEL:-0}" = "1" ]; then
      echo "==> skipping worker model check (BOUGH_NO_MODEL=1)"
    else
      prune_stale_worker_models
      ensure_worker_model || { echo "error: worker model download failed; re-run 'bough update' to resume." >&2; exit 1; }
    fi
    echo "bough updated to $(git -C "$ROOT" rev-parse --short HEAD) ($branch)."
    exit 0
    ;;
  restart)
    # Tear down any running server, then fall through to the start path below.
    stop_server
    ;;
  -h | --help)
    echo "usage: bough [restart|update]"
    echo "  (no args)  start the server and open the web UI"
    echo "  restart    stop any running server, then start a fresh one"
    echo "  update     pull the latest, rebuild, and reconcile the worker model"
    exit 0
    ;;
  "") ;;
  *)
    echo "unknown command: $1 (try: bough | bough restart | bough update)" >&2
    exit 1
    ;;
esac

[ -n "${ANTHROPIC_API_KEY:-}" ] || {
  echo "warning: ANTHROPIC_API_KEY is not set — the agent loop will fail to plan." >&2
}

echo "starting bough server..."
( cd "$ROOT/packages/bough_server" && exec gleam run ) &
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null || true' EXIT INT TERM

# Wait for /health before opening the UI.
for _ in $(seq 1 60); do
  if curl -fsS "$SERVER/health" >/dev/null 2>&1; then break; fi
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    echo "server exited before becoming healthy" >&2; exit 1
  fi
  sleep 0.5
done

# Open the web UI in the default browser (best-effort), then keep the server in
# the foreground so Ctrl-C tears it down via the trap above.
echo "bough web UI: $SERVER"
if command -v open >/dev/null 2>&1; then open "$SERVER" >/dev/null 2>&1 || true
elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$SERVER" >/dev/null 2>&1 || true
fi

wait "$SERVER_PID"
